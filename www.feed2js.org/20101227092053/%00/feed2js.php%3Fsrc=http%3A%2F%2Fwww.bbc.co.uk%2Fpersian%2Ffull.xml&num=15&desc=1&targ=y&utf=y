document.write('<li class="rss-item"><a class="rss-item" href="http://www.bbc.co.uk/persian/afghanistan/2010/12/101227_k01_af_election_court.shtml" target="_blank">افغانستان دادگاه ویژه بررسی شکایات انتخاباتی تشکیل می دهد</a><br />');
document.write('حامد کرزی، رئیس جمهوری افغانستان، با پیشنهاد ایجاد یک دادگاه اختصاصی برای رسیدگی به \"ادعاهای حقوقی\" نامزدهای معترض انتخابات جنجال برانگیز پارلمانی این کشور موافقت کرده است. دفتر آقای کرزی گفته است که این دادگاه صلاحیت دارد ادعاهای حقوقی در مورد انتخابات بیست و هفتم سنبله را بررسی کند. کمیسیون رسیدگی به شکایت های انتخاباتی افغانستان در واکنش به این تصمیم بار دیگر تاکید کرده است که نتایج اعلام شده از سوی کمیسیون انتخابات نهایی است و هیچ نهاد دیگری صلاحیت تصمیم گیری در مورد انتخابات را ندارد. از زمان اعلام نتایج نهایی انتخابات پارلمانی حدود یک ماه می گذرد اما جنجال در مورد این نتایج هنوز پایان نیافته است. دادستانی کل افغانستان تاکید دارد که در انتخابات پارلمانی تقلب صورت گرفته و باید نتایجی که از سوی کمیسیون انتخابات اعلام شده است، باطل اعلام شود. در پی این اعتراضها، دادگاه عالی افغانستان هفته پیش از رئیس جمهوری خواست تا برای رسیدگی به شکایت های انتخاباتی، یک دادگاه اختصاصی ایجاد کند. تصمیم آقای کرزی به ایجاد دادگاه اختصاصی رسیدگی به ادعاهای حقوقی نامزدهای معترض در پاسخ به این درخواست اتخاذ شده رئیس دادگاه استیناف کابل ریاست دادگاه جدید را برعهده دارد. \'شکایات حقوقی\' در همانحال، کمیسیون رسیدگی به شکایت های انتخاباتی افغانستان همچنان تاکید داشته است که براساس قانون، هیچ نهادی حق ندارد در نتایج انتخابات مداخله کند. احمد ضیا رفعت، از اعضای این کمیسیون می گوید که این نهاد، از رسیدگی به جرایم انتخاباتی در سوی دادگاه اختصاصی استقبال می کند، اما هیچ نهادی صلاحیت رسیدگی به موارد حقوقی را ندارد. اعتراضها نسبت به تقلب در انتخابات پارلمانی افغانستان از سوی بسیاری از نامزدهایی که نتوانسته اند وارد مجلس دوم افغانستان شوند مطرح شده است. این جنجالها زمانی اوج گرفت که در ولایت غزنی، هیچیک از نامزدهای مربوط به قوم پشتون نتوانست به مجلس نمایندگان راه پیدا کند. حالا شماری به این باور هستند که رئیس جمهور به منظور تغییراتی در نتایج انتخابات، تحت فشار قرار دارد و به همین دلیل، تا به حال نتایج نهایی انتخابات را نپذیرفته است. دفتر آقای کرزی این ادعاها را رد کرده و گفته است که رئیس جمهوری براساس قانون اساسی افغانستان، حاضر است مجلس دوم را در زمان تعیین شده رسما گشایش دهد. معلوم نیست کشمکش میان نهادهای قضایی و کمیسیون های مربوط به انتخابات به کجا خواهد کشید. با وجود این تنش ها، متحدان عمده حکومت افغانستان و نهادهای بین المللی، از جمله سازمان ملل متحد، از اعلام نتایج انتخابات پارلمانی افغانستان استقبال کرده اند.');

document.write('<li class="rss-item"><a class="rss-item" href="http://www.ameinfo.com/ar-192483.html" target="_blank">رئيس \"اتصالات الإماراتية\" يكشف عن قرب الانتهاء من صفقة \"زين\"</a><br />');
document.write('أعلن رئيس مجلس إدارة مؤسسة الإمارات للاتصالات (اتصالات) محمد عمران في حوارات صحفية عن قرب الانتهاء من صفقة شراء (اتصالات) ل 46% في شركة (زين) الكويتية، حسبما نقلت وكالة الأنباء الكويتية. وأشار عمران إلى توصل شركة (اتصالات) إلى اتفاق مع مجموعة من البنوك الإقليمية والعالمية لتأمين قروض بقيمة 12 مليار دولار تغطي قيمة الصفقة كاملة متوقعا الانتهاء من عملية الفحص والتدقيق والاتفاق على كامل بنود الصفقة في نهاية فبراير الجاري. وتوقع أن تحل مسالة (زين السعودية) قريبا في ظل وجود جهات عديدة ترغب في شرائها مؤكدا أن هذه الصفقة تحمل فوائد للجميع. وأوضح عمران أن (زين) الكويتية ستبقى شركة مستقلة في المدى المنظور بعد إتمام الصفقة وسيتم دعمها من قبل (اتصالات) مشيرا إلى امتلاك حصة الأغلبية فيها وتولي الإدارة يتيح دمج الشركتين في أي وقت وذلك بعد الدراسة المتأنية. <br /><a href=\"http://oas6.ameinfo.com/RealMedia/ads/click_lx.ads/ameinfo.com/rss-ar/123/x91/AME/AME-Info_RSS_AR_Generic/2149730/124\" target=\"_blank\"> <img src=\"http://oas6.ameinfo.com/RealMedia/ads/adstream_lx.ads/ameinfo.com/rss-ar/159/x91/AME/AME-Info_RSS_AR_Generic/2149730/125\" border=\"0\" /></a>');
document.write('</li>');
document.write('<li class="rss-item"><a class="rss-item" href="http://www.ameinfo.com/ar-192482.html" target="_blank">نمو أرباح الاتصالات الفلسطينية إلى 86 مليون دينار في 2010</a><br />');
document.write('ارتفعت صافي أرباح شركة الاتصالات الفلسطينية خلال العام الماضي إلى 86 مليونا و336 ألف دينار أردني مقابل 70 مليونا و335 ألف دينار في العام 2009، حسبما نشرت وكالة الأنباء القطرية. وقالت شركة الاتصالات الفلسطينية في بيان صحفي صدر عنها أمس أن مجموع موجودات الشركة بلغ خلال العام الماضي 551 مليونا و261 ألف دينار مقابل 531 مليونا و270 ألف دينار في نهاية عام 2009 .. فيما بلغ مجموع المطلوبات 159 مليونا و887 ألف دينار في نهاية عام 2010 بعد أن كان 180 مليونا و85 ألف دينار في نهاية عام 2009.');
document.write('</li>');
document.write('<li class="rss-item"><a class="rss-item" href="http://www.ameinfo.com/ar-192481.html" target="_blank">اتصالات الإماراتية تؤكد أنها ليست طرفا بفضيحة اتصالات هندية</a><br />');
document.write('جددت مؤسسة الإمارات للاتصالات (اتصالات) تأكيدها بأنها ليست طرفا في فضيحة فساد بقطاع الاتصالات الهندي أدت إلى القبض على مسؤول بوحدتها الهندية لمزاعم بارتكاب مخالفات، بحسب ما نشرت وكالة رويترز. وقال مكتب التحقيقات المركزي الهندي انه ألقى القبض على شاهد بالوا العضو المنتدب بشركة دي.بي ريلتي ونائب رئيس مجلس ادارة اتصالات دي.بي وهي مشروع مشترك بين اتصالات ومجموعة دي.بي الهندية. وأكدت اتصالات التي تملك حصة 45% تقريبا في المشروع على أنها اشترت حصتها في الوحدة الهندية -التي كانت تحمل اسم سوان في ذلك الوقت- بعد منح التراخيص. وقالت الشركة الإماراتية في بيان أنها لم تشارك بأي شكل من الأشكال في تقديم طلب الحصول على الترخيص. وأضافت أنها اشترت الحصة في الشركة معتقدة بحسن نية أن الشركة الهندية حصلت على التراخيص بشكل سليم. وقالت الشركة أنها ملتزمة بأعمالها في الهند ثاني أسرع أسواق الهاتف المحمول نموا في العالم ولن تنسحب منها.');
document.write('</li>');
document.write('<li class="rss-item"><a class="rss-item" href="http://www.ameinfo.com/ar-192378.html" target="_blank">مصادر: أوراسكوم المصرية تسعى لشراء بولكومتل البولندية</a><br />');
document.write('نقلت وكالة رويترز عن مصادر مطلعة قولها أن شركة أوراسكوم تليكوم المصرية انضمت لشركة تيليا سونيرا البولندية العملاقة للإعلام وعدد من شركات الاستثمار المباشر في سباق الاستحواذ على شركة بولكومتل اكبر مجموعة مشغلة للهاتف المحمول في بولندا من حيث الأصول. ويدرس صندوقا الاستثمار المباشر تي.بي.جي وبلاكستون احتمال التقدم بعرض مشترك. ووفقا للمصادر تلقت تلك الشركات إلى جانب بريميرا وبروفيدنس ورجل الاعمال البولندي زيجمونت سولورز-زاك مذكرة الاستثمار التي تضم وثائق مفصلة لعملية البيع والشركات المؤهلة للتقدم بعروض.');
document.write('</li>');
document.write('<li class="rss-item"><a class="rss-item" href="http://www.ameinfo.com/ar-192377.html" target="_blank">الاتصالات السعودية تعزز خدمة انترنت (FIWI) بأكثر من ألف موقع</a><br />');
document.write('واصلت الاتصالات السعودية تعزيزها في توسيع نطاق تغطية خدمة الواي فاي (Wi-Fi) التي تقدمها حصرياً ومجاناً لعملائها في خدمة آفاق DSL شامل، وX باند جود، وX باند جود بلس، وبرودباند جود، وبرودباند جود بلس، والألياف البصرية FTTH، حسبما ذكرت صحيفة الرياض. وتستهدف الشركة المزيد من المواقع العامة والمراكز التجارية والمقاهي والكورنيش وأماكن التجمعات، متيحة لجميع عملائها خصوصاً الطلاب والمعلمين الفرصة لتصفح الإنترنت في أكثر من 1000 موقع بالأماكن العامة لاسلكياً بنفس اسم المستخدم وكلمة المرور للمشترك، كما هو في المنزل، والبقاء على اتصال دائم بالإنترنت في كافة الأوقات، وأثناء تنقلهم من موقع إلى آخر بجودة وسرعة عاليتين ومن مصدر واحد دون أي تكلفة إضافية أو مبالغ مسبقة الدفع؛.');
document.write('</li>');

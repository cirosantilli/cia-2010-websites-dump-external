document.write('<table cellspacing=\"0\" cellpadding=\"0\" style=\"width: 100%; direction: rtl; text-align: left; margin-left: 0px; margin-right: 0px;\"><tbody><tr><td style=\"vertical-align: top;\"><table align=\"right\" style=\"text-align: right; direction: rtl;\"><tbody><tr><td><div style=\"text-align: right; font-family: Arial,Helvetica,sans-serif; font-size: 20px; color: rgb(3, 56, 93); font-weight: bold; margin: 10px 0px; line-height: 24px;\"><font size=\"2\"> كارگاههاي آموزشي مواد غذايي، آرايشي و دارويي در جشنواره سيماي سلامت </font></div> <div style=\"font-family: Arial,Helvetica,sans-serif; font-size: 16px; font-weight: bold; line-height: 20px; text-align: right; color: rgb(3, 56, 93);\"><font size=\"2\"> تهران - مدير روابط عمومي معاونت غذا و داروي وزارت بهداشت، درمان و آموزش پزشكي ، گفت : كارگاههاي آموزشي در زمينه مواد غذايي، لوازم آرايشي و دارويي در جشنواره سيماي سلامت برگزار مي شود. </font></div> </td> </tr> </tbody></table> </td> <td style=\"width: 250px;\"> <font size=\"2\"><a href=\"http://img.irna.ir/1389/13891028/30193466/30193466-900350.jpg\"> <img height=\"170\" width=\"250\" style=\"border: 1px solid black; margin-right: 0px; margin-left: 8px; margin-top: 0px;\" src=\"http://img.irna.ir/1389/13891028/30193466/T30193466-900350.jpg\" title=\"كارگاههاي آموزشي مواد غذايي، آرايشي و دارويي در جشنواره سيماي سلامت\" /> </a></font> </td> </tr> </tbody></table><div style=\"text-align: justify;\"> </div><div style=\"font-family: Tahoma; font-size: 14px; line-height: 28px; color: rgb(51, 51, 51); direction: rtl; text-align: justify;\"><font size=\"2\"> نخستين جشنواره و نمايشگاه سيماي سلامت در دهه فجر از 11 تا 21 بهمن ماه امسال در فضايي بالغ بر10 هزار متر مربع در پنج نقطه از تهران برگزار مي شود. <br />به گزارش روز سه شنبه جشنواره سيماي سلامت، \'اسماعيل سعادتدار\' گفت: تجويز مصرف منطقي دارو ، عوارض استفاده نادرست داروها، داروها بيمارستاني، مواد و لوازم آرايشي و استفاده صحيح از انواع مكمل ها و عواقب استفاده نادرست از آنها از جمله برنامه هاي آموزشي و اطلاع رساني است كه در اين جشنواره اجرا خواهد شد. <br />وي افزود: اين جشنواره ، نقطه عطفي در آگاه سازي و اطلاع رساني صحيح و اصولي به مردم به شمار مي رود. <br />سعادتدار با يادآوري اهميت تاثير كيفيت و نحوه مصرف دارو و غذا در زندگي روزمره افراد، ادامه داد: استانداردها و معيارهاي انتخاب صحيح مواد غذايي و مصرف منطقي دارو در طول 10 روز برگزاري جشنواره، به مردم آموزش داده مي شود. <br />مدير روابط عمومي معاونت غذا و داروي وزارت بهداشت،گفت: براي فرهنگ سازي و آموزش صحيح به كودكان و نوجوانان، مدارس مختلف نيز با هماهنگي آموزش و پرورش از اين نمايشگاه ديدار كرده مسابقه هاي نقاشي و خاطره نويسي در زمينه استفاده از دارو و مواد غذايي، آنان را در بحث آموزش و فرهنگ ، سهيم مي كنند. <br />اجتمام**9185 **1010 </font></div><div style=\"text-align: justify;\"> </div><div style=\"font-family: arial; font-weight: bold; font-size: small; line-height: 18px; color: rgb(3, 56, 93); direction: rtl; text-align: justify;\"><font size=\"2\"> انتهای خبر / خبرگزاری جمهوری اسلامی (ايرنا) / کد خبر 30193466 </font></div>');

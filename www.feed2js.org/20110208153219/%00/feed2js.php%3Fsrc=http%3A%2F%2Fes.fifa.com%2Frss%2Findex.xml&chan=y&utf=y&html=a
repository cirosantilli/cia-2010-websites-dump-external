document.write('</li>');
document.write('<li class="rss-item"><a class="rss-item" href="http://es.fifa.com/worldfootball/clubfootball/news/newsid=1378937.html?cid=rssfeed&att=" target="_self">Teófilo Gutiérrez, nuevo jugador de Racing Club</a><br />');

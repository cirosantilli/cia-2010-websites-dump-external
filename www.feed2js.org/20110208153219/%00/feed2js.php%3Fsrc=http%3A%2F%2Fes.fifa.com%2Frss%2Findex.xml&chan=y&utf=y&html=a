document.write('</li>');
document.write('<li class="rss-item"><a class="rss-item" href="http://es.fifa.com/worldfootball/clubfootball/news/newsid=1378837.html?cid=rssfeed&att=" target="_self">Nuevo reconocimiento para Mourinho</a><br />');

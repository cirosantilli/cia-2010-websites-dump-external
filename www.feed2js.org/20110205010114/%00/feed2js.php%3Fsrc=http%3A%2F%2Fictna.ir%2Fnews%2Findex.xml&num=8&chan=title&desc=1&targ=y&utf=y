document.write('<li class="rss-item"><a class="rss-item" href="http://www.ictna.ir/news/archives/032565.html" target="_blank">فراخوان همراه اول برای استفاده دوباره از GCها</a><br />');
document.write('شرکت ارتباطات سیار ایران برای شروع دوباره با پیمانکاران طراحی، نصب و راه‌اندازی آنتن‌های تلفن همراه (GC) فراخوان داد.به گزارش آژانس خبری صنعت ارتباطات (سینا)، همراه اول در نظر دارد از پیمانکاران داخلی در جهت تامین خدمات طراحی، نصب و راه‌اندازی سایت‌های BTS شبکه ارتباطات سیار ایران در تهران و سایر استان‌ها بهره‌مند شود.برهمین اساس از تمامی شرکت‌هایی که مایل به همکاری با این شرکت هستند درخواست کرده مدارک مورد نیاز جهت ارزیابی را حداکثر ظرف مدت دو هفته آینده به شرکت ارتباطات سیار ایران ارسال کنند.پس از بررسی مدارک دریافتی جهت شرکت در مناقصات و استعلام‌ها از حائزین حداقل امتیاز مورد قبول دعوت به عمل خواهد آمد و اعتبار ارزیابی دو سال از تاریخ بررسی است.شرکت‌هایی که تا سال ۱۳۸۸ مورد ارزیابی شرکت ارتباطات سیار ایران قرار گرفته‌اند نیز نیازی به ارسال مجدد مدارک نداشته و جهت تکمیل مدارک خود می‌توانند اقدام کنند.مدارک مورد نیاز و ملاک‌های ارزیابی در سایت www.mci.ir در دسترس عموم است و مشخصات فنی مرتبط با موضوع فراخوان نیز در سایت www.mcistandard.ir در بخش استانداردهای BSS موجود است....');

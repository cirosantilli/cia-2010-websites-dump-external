document.write('<li class="rss-item"><a class="rss-item" href="http://www.elpais.com/articulo/internacional/Rousseff/viaja/Argentina/primera/salida/presidenta/Brasil/elpepuint/20110131elpepuint_2/Tes" target="_blank">Rousseff viaja a Argentina en su primera salida como presidenta de Brasil</a><br />');

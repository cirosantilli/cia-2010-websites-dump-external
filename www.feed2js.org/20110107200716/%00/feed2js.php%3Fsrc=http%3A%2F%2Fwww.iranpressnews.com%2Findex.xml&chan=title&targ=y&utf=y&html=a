document.write('<li class="rss-item"><a class="rss-item" href="http://www.iranpressnews.com/source/090110.htm" target="_blank">اندیمشک؛ اجرای حکم وحشیانه شلاق در ملاعام</a><br />');
document.write('ایسنا: دادستان عمومي و انقلاب انديمشك از اجراي حكم شلاق براي يكي از كيف‌قاپ‌هاي اين شهرستان خبر داد. علي غياثوند با بيان اين مطلب، اظهار كرد: به دنبال گزارش‌هاي رسيده مبني بر اين ‌كه فردي به نام «ب- ز» از طريق كيف‌قاپي اقدام به ناامني در مركز شهر مي‌كند، موضوع پيگيري و متهم پس از شناسايي دستگير شد. وي ادامه داد: پس از اقرار متهم به جرايم ارتكابي، كيفرخواست براي وي صادر و پرونده به دادگاه ارسال شد. دادگاه فرد مذكور را به سه سال حبس و تحمل 74 ضربه شلاق در ملاءعام محكوم كرده بود. غياثوند خبر داد كه حكم شلاق اين فرد در ميدان مركزي شهر انديمشك به اجرا درآمد.');

document.write('<li class="rss-item"><a class="rss-item" href="http://www.iranpressnews.com/source/090112.htm" target="_blank">منبع حکومتی خبر افزایش کارتن خوابها را تائید کرد</a><br />');
document.write('خبرگزاری مهر: معاون اجتماعی و فرهنگی شهرداری تهران با اعلام افزایش گشتهای ویژه شهرداری برای جمع آوری کارتن خوابها، گفت: ما اکنون در شهر تهران با پدیده ناهنجاری اجتماعی مواجه هستیم. ایازی با اشاره به گلایه برخی از شهروندان به دلیل ایجاد مشکلات توسط کارتن خواب ها در فضاهای مسکونی گفت، گشتهای ویژه شهرداری برای جمع آوری کارتن خوابها در فصل سرما افزایش یافته است. افزایش کارتون خوابها در تهران خبرنگار ما از تهران - پنج شنبه 16 دیماه: زمستان و روزهای سرد سال مشقت زندگی برای فقرا و تنگ دستان را صدچندان می کند. آنچه امروز در حاشیه کوچه ها و خیابان های تهران به طور مشخص افزایش یافته شمار بیخانمان ها و کارتون خوابهایی است که بر روی زمین سرد شب را به صبح می رسانند.');

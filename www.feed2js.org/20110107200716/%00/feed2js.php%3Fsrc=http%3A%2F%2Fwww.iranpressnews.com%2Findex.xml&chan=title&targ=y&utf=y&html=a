document.write('<li class="rss-item"><a class="rss-item" href="http://www.iranpressnews.com/source/090114.htm" target="_blank">ببر سیبری؛ انجمن حمايت از حيوانات شکايت می کند</a><br />');
document.write('خبرگزاري موج - مدير روابط عمومي انجمن حفاظت از حيوانات گفت: در پي مرگ ببر سيبري، شکايت نامه اي توسط اين انجمن تنظيم و طي هفته آينده به ديوان عدالت اداري تسليم خواهد شد. عبدالرضا باقري، مدير روابط عمومي انجمن حمايت از حيوانات با اعلام اين مطلب اظهار داشت: اين شکايت نامه توسط وکيل انجمن در دست تهيه است. وي افزود: اين شکايت نامه بر عملکرد سازمان هاي حفاظت از محيط زيست و دامپزشکي در برخورد با ببر سيبري، دلالت دارد. باقري تاکيد کرد: دامپزشکي در بدو ورود ببر سيبري بدون طي مراحل قرنطينه و کنترل گواهي هاي بهداشتي مجوز ورود را صادر کرد که رفتار نادرستي بود. وي اضافه کرد: شکايت انجمن حمايت از حيوانات طي هفته آينده به ديوان عدالت اداري تسليم خواهد شد. مدير روابط عمومي انجمن حمايت از حيوانات در خصوص موضع انفعالي اين انجمن در قبال ورود ببر سيبري به کشور، تاکيد کرد: انجمن حمايت از حيوانات نامه اي اعتراضي نسبت به عملکرد سازمان حفاظت از محيط زيست به اين مجموعه تسليم کرده بود. وي واردات ببر سيبري به کشور را از ابتدا نادرست دانست و گفت: زير ساخت هاي لازم براي نگهداري از ببر سيبري در کشور فراهم نبود. باقري تصريح کرد: در ابتدا قرار بود ببر سيبري در ميانکاله نگهداري شود که با اتمام بودجه طرح، باغ وحش ارم به عنوان محل نگهداري ببرها انتخاب شد. وي اضافه کرد: مسئولين محيط زيست اعلام کردند قرار است توله هاي ببرها به ميانکاله منتقل شود اما گربه سانان در قفس زاد و ولد نمي کنند. مدير روابط عمومي انجمن حمايت از حيوانات با اشاره به وعده هاي طرف روسي مبني بر وحشي بودن دو ببر تحويلي به ايران، اظهار داشت: اين دو ببر از ابتدا در باغ وحش زندگي مي کردند. وي ادامه داد: ببرهاي وارداتي به محض ورود به قفس در باغ وحش ارم، با ظرف غذاي خود آشنا بودند که نشان دهنده سکونت قبلي آنها در باغ وحش است. باقري خاطر نشان ساخت: به هيچ وجه برگه بهداشتي و گواهي قرنطينه دو ببر سيبري وارداتي به سازمان دامپزشکي تحويل نشده و اين امر نشان مي دهد برگه بهداشتي همراه اين حيوانات نبوده است. وي رفتارهاي سازمان محيط زيست را نامناسب توصيف کرد و گفت: ورود بدون برنامه دو ببر سيبري به ايران، بازي کردن با جان دو حيوان است. مسئول روابط عمومي انجمن حمايت از حيوانات تاکيد کرد: ببر سيبري گونه نادري است که فقط در 3 باغ وحش دنيا وجود دارد. وي رفتار سازمان محيط زيست در پروژه احياي ببر مازندران را اقدامي تبليغاتي دانست و گفت: با توجه به روند انقراض حيوانات در ايران، بهتر است سرمايه هاي صرف شده در اين پروژه براي بهبود وضعيت حيات وحشي فعلي موجود در کشور هزينه شود. باقري با اشاره به اظهارات مسئولين سازمان حفاظت از محيط زيست براي ادامه پروژه احياي ببر مازندران گفت: اگر قرار است اين پروژه ادامه يابد، بايستي حتما کار کارشناسي مناسب روي آن انجام شود.');
document.write('</li>');
document.write('<li class="rss-item"><a class="rss-item" href="http://www.iranpressnews.com/source/090113.htm" target="_blank">مشاور احمدی نژاد: این فتنه تا قیام قیامت ادامه دارد</a><br />');
document.write('آخوندی بنام بنایی، نماینده مجلس شورای اسلامی نسبت به وقوع دوباره تظاهرات ضد حکومتی هشدار داد و گفت، بصیرت اقتضا‌ می ‌کند که هوشیاری خود را نسبت به وقوع فتنه‌ های بعدی افزایش دهیم چرا‌ که هیچ ضمانتی وجود ندارد که فتنه ۸۸ آخرین فتنه باشد. مهدی کلهر مشاور برکنار شده احمدی ‌نژاد نیز با هشدار مشابهی گفت، قضیه پارسال هنوز تمام نشده است و این جریان تا قیام قیامت ادامه دارد.');

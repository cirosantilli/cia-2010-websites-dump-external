document.write('<li class="rss-item"><a class="rss-item" href="http://www.iranpressnews.com/source/090106.htm" target="_blank">حذف یارانه ها؛ کاهش سفرهای تجاری</a><br />');
document.write('تجارت پرس: رئیس انجمن صنفی دفاتر خدمات مسافرت هوایی تصریح کرد: با افزایش میزان هزینه ها پیش بینی می شود که در ماه های آینده حجم سفرهای تجاری کاهش یابد. محمد حسن کرمانی، رئیس انجمن صنفی دفاتر خدمات مسافرت هوایی از فعالیت بیش از دو هزار و 600 دفاتر خدمات مسافرت هوایی در ایران خبر داد و گفت: به علت افزایش میزان هزینه ها پیش بینی می شود که آژانس های هواپیمایی با مشکلات عدیده ای مواجه شوند. وی در رابطه با بحث آزاد سازی نرخ بلیت هواپیما در ایران یادآورشد: در صورتی سیاست هدفمند سازی یارانه ها منجر به توسعه ناوگان هوایی می شود که درآمد حاصل از آن به توسعه شرکت های هواپیمایی و توسعه فرودگاه ها اختصاص یابد. اگر این ملاحظات اعمال نشود قطعا شرکت های هواپیمایی را به نابودی می کشاند.');

    <script type="text/javascript">
        var sub_symbols = 'EUR/USD,USD/JPY,GBP/USD,USD/CAD,AUD/USD'
        $(document).ready(function() {
            //updateSymbol('dow', 7856, '+58',true);
            UpdatePrices();
            setInterval('UpdatePrices()', 15000);
            swapValues = [];
            $(".swap_value").each(
            function(i) {
                swapValues[i] = $(this).val();
                $(this).focus(function() {
                    if ($(this).val() == swapValues[i]) {
                        $(this).val("")
                    }
                }
                ).blur(function() {
                    if ($.trim($(this).val()) == "") {
                        $(this).val(swapValues[i])
                    }
                }
                 )
            }
      )

            a = $('#quoteGetter').autocomplete({
                serviceUrl: '/AjaxServer.ASPX?service=LOOKUP',
                minChars: 2,
                maxHeight: 400,
                width: 300,
                zIndex: 9999,
                deferRequestBy: 100, //miliseconds
                onSelect: function(value, data) { $("#quoteGetter").val(data); getQuote(); }

            });


        });



        function UpdatePrices() {
            var current = new Date();
            var cBust = current.getHours().toString() + current.getMinutes().toString() + current.getSeconds().toString() + current.getMilliseconds().toString();
            $.getJSON('/Ajaxserver.aspx?service=DATA2&sym=' + sub_symbols + '&cbust=' + cBust,
            function newTweetsCallback(data, text) {
                if ((data != null) ) {
                    if ((data.quotes != null) && (data.quotes.length > 0)) {
                        $("#updatedthrough").text(data.udt);
                        for (i = 0; i <= data.quotes.length - 1; i++) {
                            updateSymbol(data.quotes[i].s, data.quotes[i].p, data.quotes[i].n, data.quotes[i].u);
                        }
                    }
                }
            })
        }

        function updateSymbol(sym,price,change,isup) {
            sym = sym.replace("/", "_");
            var qid = '#' + sym + '_quote';
            var cid = '#' + sym + '_change';
            var did = '#' + sym + '_dir';
            var iid = '#' + sym + '_img';

            $(qid).text(price);
            $(cid).text(change);            
            if (isup) {
                $(cid).removeClass('changedown');
                $(cid).addClass('changeup');
                $(did).removeClass('dirdown');
                $(did).addClass('dirup');
                $(iid).attr('src', 'images/greenup.png');
            } else {
                $(cid).removeClass('changeup');
                $(cid).addClass('changedown');
                $(did).removeClass('dirup');
                $(did).addClass('dirdown');
                $(iid).attr('src','images/reddown.png');
            }
        }

        function getQuote() {
            var sym = $("#quoteGetter").val();
            var url = 'http://www.freestockcharts.com/?Symbol=' + sym
           
            window.parent.location = url;
        }
    </script>

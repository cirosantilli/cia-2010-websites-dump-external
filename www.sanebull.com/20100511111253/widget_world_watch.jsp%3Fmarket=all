var SBWidget = {
	controlUrl : "/main_handler",
	asu : 0,
	ticker : '',

	ta:	{'^AEX':'aex','^JKSE':'jkse','^NZ50':'nz50','^TWII':'twii','^MERV':'merv','^BVSP':'bvsp','^GSPTSE':'tor','^MXX':'mxx','^NSEI':'nse','^BSESN':'bse','000001.SS':'ssec','^STI':'sti','^IXIC':'nasdaq','^GSPC':'sp','^DJI':'dow','^FTSE':'ftse','^GDAXI':'dax','^FCHI':'cac','^N225':'n225','^HSI':'hsi'},
	tr:	{'aex':'^AEX','jkse':'^JKSE','nz50':'^NZ50','twii':'^TWII','merv':'^MERV','bvsp':'^BVSP','tor':'^GSPTSE','mxx':'^MXX','nse':'^NSEI','bse':'^BSESN','ssec':'000001.SS','sti':'^STI','nasdaq':'^IXIC','sp':'^GSPC','dow':'^DJI','ftse':'^FTSE','dax':'^GDAXI','cac':'^FCHI','n225':'^N225','hsi':'^HSI'},








	doStart : function () {
		Element.hide('chart_content');
		SBWidget.doMarketWatch();
		SBWidget.asu = setInterval(SBWidget.doMarketWatch, 30 * 1000);
	},

	doMarketWatch : function() {
		SBWidget.doServerRequest('9', SBWidget.drawMarketWatch);
	},

	drawMarketWatch : function(r) {
		var q = eval(r.responseText);

		for (i = 0; i < q.length; i++) {
			var c = SBWidget.ta[q[i].ticker];
			if (c === undefined) continue;
 
			var changeClass = "sanebull_green";
			if (q[i].change < 0) { changeClass = "sanebull_red"; }
			$(c + '_change').className = changeClass;
			new Effect.CashRegister(c + '_current', q[i].current);	
			new Effect.CashRegister(c + '_change', q[i].change);

			if (SBWidget.ticker === c) {
				new Effect.CashRegister('c_lst', q[i].current);
				new Effect.CashRegister('c_chn', q[i].change);
				$('c_chn').className = changeClass;
			}
		}
	},

	showChart: function(w) {
		SBWidget.ticker = w;
		$('c_tik').innerHTML = $(w + '_name').innerHTML;
		$('c_lst').innerHTML = $(w + '_current').innerHTML;
		$('c_chn').innerHTML = $(w + '_change').innerHTML;
		$('c_chn').className = $(w + '_change').className;

		if (w === 'dow') {
			$('sanebull_ch').innerHTML = "<br>Dow Jones Indexes are End-of-Day only. Please refer to <a href=\"http://www.sanebull.com/privacy-policy\" target=\"_blank\">SaneBull TOS</a> for more info.";

		} else {
			 SBWidget.doRedirect2(SBWidget.tr[w]);
		}
/*		
		else
			$('sanebull_ch').innerHTML = "<a href=\"http://www.sanebull.com/m?symbol=" + SBWidget.tr[w] + "\" target=\"_blank\"><img width=\"190\" id=\"tchart_chart_img\" border=\"0\" src=\"http://ichart.finance.yahoo.com/t?s=" + SBWidget.tr[w] + "&c=" + Math.random() * 99999 + "\"\/><\/a>";
*/
		Element.hide('main_content');
		Element.show('chart_content');
		return false;
	},

	hideChart: function() {
		Element.show('main_content');
		Element.hide('chart_content');

		return false;
	},

	doRedirect: function() {
		if ( ($('stock-entry').value != 'GET QUOTE..') && ($('stock-entry').value != '') ) {
			$('form-sub').action = 'http://www.sanebull.com/redirect?symbol=' + $('stock-entry').value;
		} else {
			$('stock-entry').value = 'YHOO';
		}
	},

	doRedirect2: function(s) {
		$('form-sub').action = 'http://www.sanebull.com/redirect?symbol=' + $('stock-entry').value;
		$('stock-entry').value = s;
		$('form-sub').submit();
	},

	doServerRequest : function (a, callback) {
		new Ajax.Request(SBWidget.controlUrl, { method: 'get', parameters: 'actionName=' + a, onComplete: callback });		
	}
};

Effect.CashRegister = Class.create();
Object.extend(Object.extend(Effect.CashRegister.prototype, Effect.Base.prototype), {
	initialize: function(element, price) {
		var options = arguments[2] || {};
		this.element = $(element);
		this.startPrice = parseFloat(this.element.innerHTML);
		this.finishPrice = price;
		this.delta = (this.finishPrice - this.startPrice);
		this.start(options);
	},
	update: function(position) {
		var value = (this.startPrice + (this.delta * position)).toString().split('.');
		if (this.startPrice < 100000) {
			var cent  = value.length==1 ? '' : (value[1].length == 1 ? "." + value[1]+"0" : "." + value[1].substring(0,2));
			Element.update(this.element, value[0] + cent);
		} else {
			Element.update(this.element, value[0]);
		}
	}
});

Event.observe(window, 'load', SBWidget.doStart, false);

// ]]>

document.write('<li class="rss-item"><a class="rss-item" href="http://vb.acmilanclub.com/showthread.php?t=337265&goto=newpost" target="_blank">دوري أبطال آسيا : الاهلي يتعادل بهدفين مع النصر الاماراتي ويضمن صدارة المجموعه</a><br />');
document.write('انتهى اللقاء الذي جمع الأهلي والنصر الإماراتي بالتعادل الإيجابي بهدفين لمثلهما ضمن لقاءات الجولة الأخيرة من المجموعة الثالثة لدوري أبطال آسيا 2013، وكان الأهلي هو البادئ بالتسجيل عن طريق وليد باخشوين من ركلة جزاء عند الدقيقة 7 قبل أن يعادل محترف النصر الإماراتي ليوناردو ليما النتيجة لفريقه من نقطة الجزاء عند الدقيقة 23 ويضيف راشد مال الله الهدف الثاني للنصر الإماراتي في الدقيقة 54 وتكفل تيسير الجاسم بتسجيل هدف التعادل للأهلي بتسديدة قوية من مسافة بعيدة سكنت شباك النصر الإماراتي عند الدقيقة 77 ، وكان مدرب الفريق أليكس قد أجرى ثلاث تبديلات خلال مجريات الشوط الثاني حيث أشرك كلا من : تيسير الجاسم – ياسر الفهمي – أسامة هوساوي بدلا من : محسن العيسى – عيسى المحياني – عقيل بلغيث ، لينهي الأهلي مشوار المجموعة في المركز الأول برصيد 14 نقطة وسيلاقي في دور الستة عشر صاحب المركز الثاني من المجموعة الأولى التي تأهل منها فريقي الشباب السعودي والجيش القطري وسيتحدد من خلال لقاءات الغد صاحبي المركز الأول والثاني في المجموعة حيث سيكون لقاء الذهاب في دور الستة عشر على أرض المتأهل من المجموعة الأولى مساء الثلاثاء 14 مايو المقبل بينما سيستضيف الأهلي لقاء الإياب على ملعب مدينة الملك عبدالعزيز الرياضية بالشرائع مساء الثلاثاء 21 مايو .. فيما سيعود الأهلي مجدداً للمنافسة المحلية مساء السبت المقبل 4 مايو بلقاء النصر على ملعب مدينة الملك عبدالعزيز الرياضية بالشرائع في ذهاب دور الثمانية لكأس خادم الحرمين الشريفين للأبطال .. المصدر');

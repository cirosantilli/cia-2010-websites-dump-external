document.write('<li class="rss-item"><a class="rss-item" href="http://www.worldpoliticsreview.com/articles/7779/defending-the-u-n-security-councils-honor" target="_blank">Defending the U.N. Security Council\'s Honor</a><br />');
document.write('U.N. experts who argue that the Security Council\'s credibility rests on its appeal to big players in the global system were comforted by Germany, India and South Africa\'s successful campaigns for two-year seats on the council last year. But some poor, weak governments have decided to defy it, with a series of African leaders, in particular, showing contempt for the council\'s authority.<div class=\"feedflare\"> <a href=\"http://feeds.feedburner.com/~ff/worldpoliticsreview?a=44w67f_GX7w:Vm-D33E1Ig0:yIl2AUoC8zA\"><img src=\"http://feeds.feedburner.com/~ff/worldpoliticsreview?d=yIl2AUoC8zA\" border=\"0\"></img></a> <a href=\"http://feeds.feedburner.com/~ff/worldpoliticsreview?a=44w67f_GX7w:Vm-D33E1Ig0:bcOpcFrp8Mo\"><img src=\"http://feeds.feedburner.com/~ff/worldpoliticsreview?d=bcOpcFrp8Mo\" border=\"0\"></img></a> <a href=\"http://feeds.feedburner.com/~ff/worldpoliticsreview?a=44w67f_GX7w:Vm-D33E1Ig0:V_sGLiPBpWU\"><img src=\"http://feeds.feedburner.com/~ff/worldpoliticsreview?i=44w67f_GX7w:Vm-D33E1Ig0:V_sGLiPBpWU\" border=\"0\"></img></a> <a href=\"http://feeds.feedburner.com/~ff/worldpoliticsreview?a=44w67f_GX7w:Vm-D33E1Ig0:qj6IDK7rITs\"><img src=\"http://feeds.feedburner.com/~ff/worldpoliticsreview?d=qj6IDK7rITs\" border=\"0\"></img></a> </div><img src=\"http://feeds.feedburner.com/~r/worldpoliticsreview/~4/44w67f_GX7w\" height=\"1\" width=\"1\"/>');

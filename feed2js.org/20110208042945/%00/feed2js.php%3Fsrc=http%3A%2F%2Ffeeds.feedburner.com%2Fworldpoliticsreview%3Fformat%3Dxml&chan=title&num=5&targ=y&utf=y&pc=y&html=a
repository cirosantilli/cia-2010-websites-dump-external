document.write('<li class="rss-item"><a class="rss-item" href="http://www.worldpoliticsreview.com/articles/7792/ireland-enters-season-of-political-turmoil-part-i" target="_blank">Ireland Enters Season of Political Turmoil: Part I</a><br />');
document.write('DUBLIN -- After months of lurching from crisis to crisis, the government of Ireland\'s Prime Minister Brian Cowen came to an end Tuesday, with new elections to be held Feb. 25. With a disapproval rating of 95 percent, Cowen\'s is the most unpopular government in the history of the state, and his party has gone from being the most successful in Europe to the brink of annihilation.<div class=\"feedflare\"> <a href=\"http://feeds.feedburner.com/~ff/worldpoliticsreview?a=SWuu7CqYtuY:Bq67f8RsGn4:yIl2AUoC8zA\"><img src=\"http://feeds.feedburner.com/~ff/worldpoliticsreview?d=yIl2AUoC8zA\" border=\"0\"></img></a> <a href=\"http://feeds.feedburner.com/~ff/worldpoliticsreview?a=SWuu7CqYtuY:Bq67f8RsGn4:bcOpcFrp8Mo\"><img src=\"http://feeds.feedburner.com/~ff/worldpoliticsreview?d=bcOpcFrp8Mo\" border=\"0\"></img></a> <a href=\"http://feeds.feedburner.com/~ff/worldpoliticsreview?a=SWuu7CqYtuY:Bq67f8RsGn4:V_sGLiPBpWU\"><img src=\"http://feeds.feedburner.com/~ff/worldpoliticsreview?i=SWuu7CqYtuY:Bq67f8RsGn4:V_sGLiPBpWU\" border=\"0\"></img></a> <a href=\"http://feeds.feedburner.com/~ff/worldpoliticsreview?a=SWuu7CqYtuY:Bq67f8RsGn4:qj6IDK7rITs\"><img src=\"http://feeds.feedburner.com/~ff/worldpoliticsreview?d=qj6IDK7rITs\" border=\"0\"></img></a> </div><img src=\"http://feeds.feedburner.com/~r/worldpoliticsreview/~4/SWuu7CqYtuY\" height=\"1\" width=\"1\"/>');

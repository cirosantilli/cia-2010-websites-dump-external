document.write('As the trials of opposition politicians in Belarus approach, Amnesty International examines human rights violations committed by the Belarusian authorities in the aftermath of Alyaksandr Lukashenka\'s fourth re-election last December. Hundreds of people were detained and many were beaten by riot police during the dispersal of a demonstration on election night on 19 December.<br><div class=\"feedflare\"> <a href=\"http://feeds.feedburner.com/~ff/worldpoliticsreviewvideo?a=hZx8qajbEIs:4KRCv6oi2So:yIl2AUoC8zA\"><img src=\"http://feeds.feedburner.com/~ff/worldpoliticsreviewvideo?d=yIl2AUoC8zA\" border=\"0\"></img></a> <a href=\"http://feeds.feedburner.com/~ff/worldpoliticsreviewvideo?a=hZx8qajbEIs:4KRCv6oi2So:V_sGLiPBpWU\"><img src=\"http://feeds.feedburner.com/~ff/worldpoliticsreviewvideo?i=hZx8qajbEIs:4KRCv6oi2So:V_sGLiPBpWU\" border=\"0\"></img></a> <a href=\"http://feeds.feedburner.com/~ff/worldpoliticsreviewvideo?a=hZx8qajbEIs:4KRCv6oi2So:qj6IDK7rITs\"><img src=\"http://feeds.feedburner.com/~ff/worldpoliticsreviewvideo?d=qj6IDK7rITs\" border=\"0\"></img></a> </div>');

document.write('<li class="rss-item"><a class="rss-item" href="http://www.aaknews.com/#!428659" target="_blank">مؤكدة التزامها بدعم مؤسسات المجتمع بابكو تطفئ شمعتها الـ 82 وسط إنجازات متواصلة</a><br />');
document.write('أصدرت النجمة الأسبوعية في شركة نفط البحرين \"بابكو\" عددها الثالث في ثوبه الجديد يوم الأربعاء وتطرق الإصدار إلى إحدى المناسبات التاريخية العزيزة في بابكو وهي ذكرى تأسيس هذه الشركة الوطنية العريقة، حيث تشهد هذه الأيام ذكرى مرور 82 عاما على تأسيس شركة نفط البحرين عبر مسيرة طويلة من العطاء والنجاح والإنجاز في خدمة مملكة البحرين ودعم اقتصادها الوطني . ففي 7 يناير 1929 صدر قرار تأسيس شركة نفط البحرين المحدودة طبقا لأحكام الفصل السابع والعشرين من قانون الشركات الكندي لسنة 1927 المعدل . وقد بلغ رأس مال التأسيس 500 ألف دولار مقسمة إلى 5000 سهم بقيمة اسمية مقدارها 100 دولار للسهم الواحد . واستعرضت النجمة الأسبوعية لمحات مضيئة من عبق التاريخ وقالت : \"ومع بداية العشرينيات من القرن الماضي زار البلاد الميجر النيوزلندي فرانك هولمز من أجل الحصول على امتياز التنقيب عن النفط ولتقريب المسافة من الحصول على الامتياز قام بحفر عدة آبار ارتوازية مدت المواطنين بالمياه العذبة وبنت رصيدا من المحبة لهذا الرجل في نفوسهم . وقد اتضح من التحاليل والتجارب التي أجراها الجيولوجي جي بي بليجرام في بداية القرن العشرين إمكانية وجود البترول في هذه المنطقة . وأجرى هولمز مفاوضات وحصل على امتياز التنقيب عن النفط لمدة عامين في البداية ابتداءً من 2 ديسمبر عام 1925 وحاول هولمز إشراك شركة النفط الإنجليزية الفارسية في هذا الامتياز إلا أن ذلك لم يلق القبول من جيولوجيي الشركة الذين ظنوا بحسب اعتقادهم أن النفط لا وجود له في منطقة جنوب البصرة\" . وأضافت المجلة الأسبوعية قائلة: \"وفي السابع والعشرين من ديسمبر عام 1928 اشترت شركة ستاندرد أويل أوف كاليفورنيا - سوكال امتياز التنقيب عن النفط في البحرين من الشركة السابقة . ومنذ ذلك اليوم، بدأ العمل بجدية أكثر وتخطيط أدق، فتأسست في كندا شركة نفط البحرين \"بابكو\" في 11 يناير 1929 وهي شركة فرعية مملوكة بالكامل من قبل شركة ستاندرد أويل أوف كاليفورنيا لكي تضفي على الشركة الصفة البريطانية بمقتضى القانون الكندي. وحول حق التنقيب عن النفط، وفي أغسطس عام 1930 وقع المغفور له الشيخ حمد بن عيسى آل خليفة - نائب الحاكم آنذاك عقدا رسميا بامتياز التنقيب . ونصت بنود العقد على منح الشركة حق التنقيب عن النفط في منطقة مساحتها الإجمالية 100 هكتار تقريبا، على أن تقوم الشركة بدفع 10 روبيات (أقل من ثلاثة دولارات أمريكية) للحكومة عن كل طن من النفط يتم استخراجه\". واستطردت النجمة الأسبوعية قائلة: \"وعلى الفور، بدأت الشركة عمليات المسح بصورة أشمل وأكبر. وفي أكتوبر 1930 بدأ التحضير لحفر أول بئر في المنطقة القريبة من جبل الدخان. وازداد وصول الإمدادات والمعدات لعمليات الحفر ابتداءً من 16 أكتوبر عام 1931، وذلك بعد ان وصل إلى البلاد السيد إدوارد سكينز أول رئيس لشركة نفط البحرين. وقامت شركة بابكو باكتشاف الغاز عام 1948 حيث تعتبر أول شركة في المنطقة لاكتشاف غاز الخف الذي ساهم في قيام العديد من القطاعات الصناعية التي تعتمد على الغاز الطبيعي\". لقد رسمت شركة بابكو على مدار ثمانية عقود خطى واثقة من التطور والانتقال من مجرد بدايات متواضعة إلى صرح وطني شامخ وكيان صناعي عريق يسهم بصورة كبيرة في مؤازرة الجهود الرامية الى ترسيخ دعائم النهضة المباركة والتنمية المستدامة في ربوع مملكة البحرين. وحققت شركة بابكو في اكثر من 80 عاما العديد من الإنجازات والإسهامات والنجاحات التي تبعث على كل الفخر والاعتزاز. ونالت الشركة الكثير من جوائز التقدير والتكريم في شتى المحافل الدولية اعترافا بالمكانة المرموقة التي تتبوأها الشركة في عالم صناعة النفط على المستويين الإقليمي والدولي. وقد أسهمت بابكو في تطوير قطاع الصناعة والارتقاء به وفق الطموحات المنشودة، مما كان له عظيم الأثر في توسيع القاعدة الصناعية على مستوى المنطقة . كما نجحت الشركة طوال الأعوام الماضية في تأكيد دورها الريادي باعتبارها مؤسسة وطنية رائدة تحرص على تأكيد شراكتها المجتمعية وتؤكد التزامها التام بمسئوليتها الاجتماعية تجاه الأفراد والمجتمع ودعم مؤسسات الدولة من أجل رفاهية الوطن. لقد واجهت بدايات الشركة الكثير من الصعوبات والتحديات والظروف القاسية إلا أن الشركة تمكنت من الصمود أمامها والتغلب عليها وقبول التحدي بكل حماس وإصرار بفضل عزم وإيمان رجالها المخلصين وسواعدهم الفتية التي أضاءت الطريق وسطرت بكل اقتدار أروع قصص النجاح والإنجاز. وعكفت الشركة طيلة الأعوام الماضية على تطوير خدماتها ومشتقاتها النفطية ودأبت على تحديث عملياتها التشغيلية وفق احدث تقنيات الصناعة المعمول بها على مستوى العالم. ونجحت الشركة في ترسيخ مفاهيم السلامة المهنية ونشر الوعي بمبادئ وقيم البيئة والصحة والسلامة من خلال فعاليات جادة وطموحة أسهمت إلى حد بعيد في تثقيف أفراد المجتمع وتعريفهم بأهمية الالتزام بهذه المبادئ من أجل الاستمتاع بحياة سليمة وهانئة. وواصلت الشركة تدشين برامجها الطموحة في مجال الامتثال البيئي وتخصيص استثمارات طائلة تربو على مئات الملايين من الدولارات بغية الحفاظ على البيئة وضمان الالتزام بمعايير ومستويات البيئة والاشتراطات العالمية الصارمة في هذا المجال من اجل تحسين جودة الهواء وخلق بيئة صحية لأجيال الحاضر والمستقبل. وحققت الشركة قفزات هائلة في حماية البيئة البحرية وتطوير برامج الاستجابة الفورية لحالات الانسكاب النفطي. وأكدت الشركة ان البيئة والصحة والسلامة باتت ركنا جوهريا في استراتيجيات بابكو وثقافتها المؤسساتية. وتواصل شركة بابكو الالتزام التام بمواصفات الجودة الصناعية والوفاء بمتطلبات ومعايير الجودة المعمول بها على مستوى العالم من أجل تأكيد ريادتها المعهودة في تطبيق أرقى مستويات الجودة في جميع عملياتها التشغيلية. ودأبت شركة بابكو في السنوات الأخيرة على تحديث المصفاة في إطار الخطة الرئيسية لتحديثها وهي عبارة عن برنامج طموح يهدف إلى توسيع العمليات التشغيلية وتحديثها وفق تقنيات العصر الحديث وبما يواكب أحدث التوجهات العالمية في هذا الخصوص. ومن مجرد عمليات تشغيلية متواضعة أصبحت مصفاة بابكو صرحا تقنيا حديثا يواكب أحدث توجهات التكنولوجيا الصناعية، مما حدا بالشركة الآن على ان تضم أكثر من 170 خزانا مطورا بطاقة تخزينية إجمالية تصل إلى 14 مليون برميل. ومع تحديث عملياتها التشغيلية بصورة متواصلة تعد مصفاة بابكو أول مصفاة في دول مجلس التعاون الخليجي قادرة على إنتاج كميات كمية من الديزل المنخفض الكبريت. وتجدر الإشارة الى أن أول يونيو 1932 شهد اكتشاف النفط في البحرين من البئر رقم واحد لتكون البحرين بمثابة أول دولة في مجلس التعاون الخليجي يتم اكتشاف النفط بها. ولم تستمر فترة انتظار تدفق النفط طويلا إذ تحقق الحلم في عام 1934 بتدفق النفط من البئر رقم واحد، مما شجع آنذاك على حفر المزيد من الآبار ليرتفع الإنتاج عام 1939 إلى 21 ألف برميل يوميا. وبعد ان انتهاء الحرب العالمية الثانية تم إعادة فتح آبار النفط المغلقة وارتفع الإنتاج إلى 45 ألف برميل يوميا مع أواخر حقبة الخمسينيات. واليوم، تفخر شركة بابكو بالقدرة على تكرير أكثر من 265 الف برميل يوميا من النفط الخام. ومنذ تأسيسها وحتى اليوم تضطلع بابكو بدور جوهري في مسيرة الاقتصاد الوطني البحريني وتسهم بشكل فعال في مختلف القطاعات الاقتصادية والصناعية والاجتماعية في المجتمع البحريني. إن إدارة بابكو تعكف في الوقت الراهن بصورة جادة وبتوجيهات واعية ودعم متواصل وفعال من الدكتور عبدالحسين بن علي ميرزا وزير شئون النفط والغاز رئيس الهيئة الوطنية للنفط والغاز رئيس مجلس إدارة شركة بابكو على مواصلة مسيرة النجاح والإنجاز في بابكو وتأكيد دور الشركة المحوري في خدمة رفاهية المجتمع وتحقيق الرقي المنشود للوطن.');

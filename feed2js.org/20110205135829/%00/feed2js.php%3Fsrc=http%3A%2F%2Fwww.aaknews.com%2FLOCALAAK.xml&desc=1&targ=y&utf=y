document.write('<li class="rss-item"><a class="rss-item" href="http://www.aaknews.com/#!428676" target="_blank">بحرينيون يعبرون عن تضامنهم مع الشعب المصري</a><br />');
document.write('عبر مواطنون بحرينيون في اعتصام سلمي مرخص له من قبل وزارة الداخلية البحرينية عصر أمس عن تضامنهم مع أشقائهم في جمهورية مصر العربية. وشهد الاعتصام السلمي ــ الذي دعت إليه مجموعة من الجمعيات السياسية والنقابات البحرينية بالقرب من السفارة المصرية في العاصمة المنامة ــ هتافات متعددة ولافتات مؤيدة لمطالب الشعب المصري الشقيق. كما عبر المشاركون عن كامل مساندتهم للحركة السلمية الحضارية التي يقوم بها الشعب المصري الشقيق وحقه في التعبير السلمي عن مطالبه، متمنين لهم مزيدا من الأمن والأمان والاستقرار لاستكمال مسيرة جمهورية مصر العربية نحو المزيد من التقدم لأبناء شعبها ومواصلة دورها الرئيسي في الدفاع عن قضايا الأمة العربية. وقد صدر بيان عن 137 من أدباء وفناني ومثقفي مملكة البحرين على رأسهم الدكتور علي محمد فخرو وزير التربية والتعليم الأسبق والدكتور عيسى أمين وكيل وزارة الثقافة السابق والأديب الأستاذ قاسم حداد عبروا فيه عن وقوفهم وتضامنهم مع شعب مصر وهو يصوغ لحظته التاريخية من أجل الحرية والكرامة.');

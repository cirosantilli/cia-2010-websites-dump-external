document.write('<li class="rss-item"><a class="rss-item" href="http://www.aaknews.com/#!428671" target="_blank">ممثل ثامنة الوسطى يشيد بتوجيهات رئيس الوزراء لإيجاد برنامج وطني لإعادة بناء البيوت الآيلة</a><br />');
document.write('ثمن العضو البلدي أحمد الأنصاري ممثل الدائرة الثامنة بالمجلس البلدي بالمحافظة الوسطى لقاء سمو رئيس الوزراء برؤساء المجالس البلدية وتوجيهاته الكريمة بإيجاد برنامج وطني متكامل لإعادة بناء البيوت الآيلة للسقوط وترميم البيوت ضمن مشروع التنمية الحضرية لتلبية احتياجات المواطنين. وقال الأنصاري إن هناك حاجة ماسّة الى تحويل هذه التوجيهات إلى خطوات فعلية وواقع عملي على الأرض ، من أجل إنقاذ المشروع من الاحتضار ، بعد أن فقد البوصلة تماما، وأهدافه لم تعد واضحة، والملف برمته تحول الى مشكلة مزمنة وعبئا على الأهالي والبلديين والنواب. وقال الأنصاري لقد استغرق المشروع الكثير من الوقت من دون أن يحقق أهدافه المنشودة ، فمنذ أن صدرت المكرمة الملكية في 2004 كان من المفترض أن يتم بناء 5000 بيت على مدى خمس سنوات أي أن ينتهي المشروع في 2009، لكننا في 2011 والمشروع لايزال يحبو بل ويزداد تعقيدا، وذلك باعتراف تقرير ديوان الرقابة المالية نفسه الذي أشار إلى أنه خلال الفترة 2004-2009 قامت وزارة البلديات ببناء 9% فقط من عدد البيوت في الخطة الموضوعة!، أما خطة الوزارة ببناء 1000 بيت بالمحافظات الخمس في سنتين فإنها غير مقبولة بالمرة ولا تمثل الحد الأدنى للبيوت المطلوب إعادة بنائها، والتي تفوق هذا العدد بكثير.');

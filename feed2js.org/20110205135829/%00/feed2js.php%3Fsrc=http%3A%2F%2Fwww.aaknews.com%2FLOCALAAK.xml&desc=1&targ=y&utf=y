document.write('<li class="rss-item"><a class="rss-item" href="http://www.aaknews.com/#!428652" target="_blank">محافظ الوسطى يدشن رفع راية البحرين ضمن الحملة الوطنية في ممشى الاستقلال</a><br />');
document.write('أكد السيد مبارك بن أحمد الفاضل محافظ المحافظة الوسطى أن فكرة ومبادرة الحملة الوطنية \"راية البحرين\"، هي تعبير صادق عن مشاعر الحب والولاء للوطن ولقيادته الحكيمة، موضحا أنها فكرة وطنية تجسد الكثير من القيم والأهداف الوطنية النبيلة، معربا عن شكره وتقديره للجنة المنظمة والمشرفة على الحملة. وأضاف محافظ المحافظة الوسطى خلال تدشينه أمس \"الجمعة\" في ممشى الاستقلال رفع راية البحرين ضمن الحملة الوطنية بحضور كل من الشيخة نورة بنت خليفة آل خليفة، رئيسة اللجنة المنظمة والنائب عيسى القاضي والنائب عدنان المالكي وعدد من المسئولين بالمحافظة وأعضاء اللجنة التنظيمية والأهالي، مؤكدا أن المحافظة تنطلق في ترحيبها ومساهمتها في دعم الحملة من حرصها الدائم على التعاون والتواصل مع مختلف الفعاليات والأنشطة والبرامج الوطنية والأهلية بما يخدم الأهداف المشتركة في إطار الشراكة المجتمعية التي طرحها ويدعمها معالي الفريق الركن الشيخ راشد بن عبدالله آل خليفة وزير الداخلية. وأشار المحافظ إلى أن تعاون وتفاعل مجتمع المحافظة الوسطى مع الحملة الوطنية يأتي في إطار التفاف أبناء المحافظة حول راية الوطن كرمز يدعو إلى الفخر والاعتزاز وحرصا منهم على أن تظل راية البحرين خفاقة عالية ترفرف في كل الميادين والمحافل، وتبقى مرفوعة بسواعد أهل البحرين الأوفياء، وتأكيدا للانتماء والولاء للوطن وقيادته الحكيمة. وقد شاركت الفرقة الموسيقية للشرطة وفرقة من حرس الشرف في حفل مراسم تدشين الحملة ورفع علم البحرين وسط حضور جماهيري. واشتمل برنامج الحفل على توزيع مجموعة من أعلام المملكة على الحضور وإقامة عدد من الفعاليات الترفيهية وتقديم هدايا للأطفال.');
document.write('</li>');
document.write('<li class="rss-item"><a class="rss-item" href="http://www.aaknews.com/#!428653" target="_blank">بمشاركة 12 فردا يعاني السمنة ... مركز صباح السالم يعلن برنامج الرابح الأكبر</a><br />');
document.write('نظم مركز صباح السالم الصباح الصحي محاضرة صحية تحت عنوان الطرق الصحية لإنقاص الوزن وذلك ضمن برنامج الرابح الأكبر الذي يشرف المركز على تنظيمه ويهدف إلي توعية المشاركين فيه حول السلوكات السليمة للتغذية ومواجهة السمنة. وقدمت اختصاصية التغذية بالمركز مروة حسين برنامج عمل المحاضرة الذي اشتمل على مجموعة من النقاط منها الطرق الصحية لإنقاص الوزن والأساليب السليمة لذلك إضافة إلى شرح عن الحمية المنخفضة السعرات الحرارية والوجبات المتوازنة والحميات التجارية المتعلقة بالمراهم والصابون والملصقات وغيرها من الأمور التجارية التي يروج لها على أنها تساعد على تخفيف الوزن. من جانبها قالت الدكتورة شيخة بوعلي مشرفة البرنامج إن البرنامج يهدف إلى تعزيز الصحة وقد تم إطلاقه بمناسبة اليوم العالمي للسكر ويستمر مدة ستة أشهر ، مشيرة إلى ان من شروط المشاركة فيه أن يكون الشخص المتقدم يعاني من السمنة أو السمنة المفرطة. وأضافت أن البرنامج وفور اعلانه تقدم 25 شخصا للانضمام إليه بيد انه تم قبول 12 شخصا منهم وهم الآن يخضعون لمحاضرات توعية عن السمنة ومخاطرها باشراف اختصاصية التغذية بالمركز كما يتم ترتيب لقاء كل أسبوعين معهم يتم خلاله إخضاعهم للفحوصات اللازمة للتأكد من سلامتهم وسيرهم بالبرنامج حسب الخطة الموضوعة لهم إضافة إلي إخضاعهم لتحاليل مختبريه كل 3 أشهر، وقد بدأ العمل بهذا البرنامج بتاريخ 10 نوفمبر 2010 على أن يتم الانتهاء منه في 10 مايو .2011');
document.write('</li>');
document.write('<li class="rss-item"><a class="rss-item" href="http://www.aaknews.com/#!428654" target="_blank">تنفيذا لتوجيهات رئيس الوزراء الجودر: بحث احتياجات مركز شباب الشاخورة</a><br />');
document.write('تنفيذا لتوجيهات صاحب السمو الملكي الأمير خليفة بن سلمان آل خليفة رئيس الوزراء قام السيد هشام محمد الجودر رئيس المؤسسة العامة للشباب والرياضة بزيارة لمركز شباب الشاخورة التقى خلالها رئيس المركز علي محسن سبت وعددا من أعضاء مجلس الإدارة. واستمع الجودر خلال الزيارة إلى خطط وبرامج مركز شباب الشاخورة الرامية إلى الارتقاء بدوره في خدمة الحركة الشبابية في المملكة وتطوير الحركة الشبابية بالإضافة إلى المشروعات المستقبلية التي ينوي مجلس إدارة المركز تنفيذها، كما اطلع الجودر على احتياجات المركز في المرحلة المقبلة من صيانة وتطوير المنشآت الشبابية. ووجه رئيس المؤسسة العامة للشباب والرياضة إدارة الشئون الفنية بسرعة العمل على صيانة المركز وتقديم جميع الخدمات اللازمة له كما وجه إدارة الهيئات الشبابية بدعم الأنشطة والبرامج التي يقيمها المركز وتوفير كل أشكال الدعم والمساندة له من اجل تنفيذ خططه وبرامجه الرامية إلى الارتقاء بالواقع الشبابي في منطقة الشاخورة الأمر الذي سينعكس إيجابا على مسيرة الحركة الشبابية في المملكة. وبهذه المناسبة أعرب الجودر عن تقديره واعتزازه بتوجيهات صاحب السمو الملكي رئيس الوزراء للمؤسسة العامة للشباب والرياضة بالاطلاع على احتياجات مركز شباب الشاخورة والاستماع إلى رغبة إدارة المركز بصيانة المركز وتطوير ملاعب كرة القدم التي تخدم الحركة الشبابية في المنطقة بما يعود بالفائدة على الشباب وعلى مملكتنا الغالية مشيرا إلى أن عنصر الشباب يشكل النسبة الكبرى من عدد السكان ونفتخر بالمكانة المتميزة التي يحتلها الشباب في عملية التنمية التي تشهدها المملكة. وأشار الجودر إلى أن المؤسسة العامة للشباب والرياضة تسعى دوما للعمل على احتضان الشباب في مختلف مدن وقرى المملكة وذلك من خلال وضع الاستراتيجيات والخطط التي تخدم الشباب بشكل عام ومنتسبي المراكز الشبابية بشكل خاص مشيرا إلى أن الاستراتيجية الجديدة للمؤسسة العامة للشباب والرياضة تعتمد على استثمار ورعاية واحتضان الشباب لما تمتلكه هذه الفئة من مخزون كبير من الطاقات الشبابية المختلفة والتي تمكنت من خلال وسائل الاتصال المتعددة والمختلفة من الانفتاح على ثقافات وحضارات العالم وتلقي الأطروحات المفيدة الأمر الذي يفرض على المؤسسة العامة للشباب والرياضة الاعتناء بالشباب ورعايتهم واحتضانهم من خلال برامج وفعاليات تعمل على صقل وتطوير هذه الطاقات وتنمية مهاراتهم وشغل أوقات فراغهم ببرامج تعود عليهم وعلى المجتمع بالنفع والفائدة. وأشار الجودر إلى أن المؤسسة العامة تعمل سنويا على تنفيذ العديد من برامج التوعية والتوجيه الوطني للشباب التي ترمي إلى تعزيز روح المواطنة والانتماء الوطني في نفوس الشباب والارتقاء بمهاراتهم المختلفة وإشغال أوقات فراغهم بما يعود بالخير والنفع عليهم وصولاً إلى بناء جيل منتم إلى وطنه وحريص على إعلاء شأنه وبذل كل جهد ممكن من أجل المحافظة على مكتسباته ومقدراته الوطنية. ومن جانبه أعرب رئيس مركز شباب الشاخورة عن تقديره لتوجيهات صاحب السمو الملكي رئيس الوزراء بالاطلاع على احتياجات المركز مؤكدا أن هذه التوجيهات تؤكد مدى الرعاية التي يوليها سمو رئيس الوزراء للشباب واهتمامه بتلبية احتياجاتهم في مختلف النواحي مشيدا بالدور الكبير الذي يقوم به رئيس المؤسسة العامة للشباب والرياضة في دعم الحركة الشبابية والمراكز الشبابية والوصول بها إلى أعلى المستويات حتى باتت هذه الحركة تجربة رائدة يحتذى بها. وأضاف سبت أن تطوير مركز شباب الشاخورة ستكون له انعكاسات ايجابية في استقطاب طاقات الشباب وحفزهم على ممارسة الأنشطة الهادفة للارتقاء بمهاراتهم المختلفة والابتعاد عن الأخطار التي تحدق بالشباب مشيرا الى ان المركز الشبابي يشكل عنصر جذب لطاقات شباب المنطقة ومكانا مناسبا لممارسة الأنشطة الشبابية والرياضية التي ستعمل على احتضان الشباب وتوجيه طاقاتهم نحو خدمة المملكة.');

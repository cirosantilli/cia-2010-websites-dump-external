document.write('<li class="rss-item"><a class="rss-item" href="http://www.aaknews.com/#!428666" target="_blank">ضحايا لحرائق المنازل ومواقع العمل بصفة يومية في البحرين</a><br />');
document.write('كشف مسئولون بمجمع السلمانية الطبي أن المستشفى يستقبل بمعدل يومي ضحية واحدة على أقل تقدير من جراء الحروق بسبب حوادث الحرائق في المنازل ومواقع العمل. وقد صرح الدكتور بي.في. شيريان مسئول بدائرة الحوادث والطوارئ للزميلة (جلف ديلي نيوز) بأن هناك العديد من الضحايا الذين تعرضوا لإصابات الحرائق في مطابخ المنازل والبعض الآخر أصيب بحروق خطيرة في مواقع أعمالهم، مشيرا إلى أن مستشفى السلمانية تلقى العديد من ضحايا الحرائق خلال الأسابيع القليلة الماضية والتي أدى بعضها إلى الوفاة. وتحدث الدكتور شيريان بعد وفاة الأم الآسيوية التي تعرضت لحادثة حريق بنسبة 100% وهي في مطبخ منزلها الكائن بالقضيبية، كما تعرض ثلاثة آخرون لإصابات خطيرة بمن فيهم زوجها. وقال الدكتور شيريان إن خمس ضحايا بمن فيهم الأم الآسيوية هم حصيلة وفيات حوادث الحرائق منذ بداية شهر ديسمبر الماضي. وأضاف أن القليل من التوعية قد يساهم في تقليص عدد ضحايا حوادث الحرائق.');

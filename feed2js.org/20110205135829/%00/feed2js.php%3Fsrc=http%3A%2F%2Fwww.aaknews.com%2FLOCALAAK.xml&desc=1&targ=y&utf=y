document.write('<li class="rss-item"><a class="rss-item" href="http://www.aaknews.com/#!428664" target="_blank">خطيب جامع خليفة الظهراني: أعظم نعمة بعد التوحيد هي الأمن والأمان</a><br />');
document.write('تطرق خطيب جامع أحمد بن خليفة الظهراني في مدينة الحد صلاح بن محمد بوحسن إلى وجوب لزوم جماعة المسلمين وعدم الفرقة والشقاق والوقوف في وجه كل من تسول له نفسه تحريض المسلمين على ولاة أمورهم وكل من يسعى إلى تفرقة وشق صف المسلمين لقوله تعالى: \"واعتصموا بحبل الله جميعا ولا تفرقوا\" ذكر ابن ابي حاتم في تفسيره عن ثابت بن قطبة، قال: سمعت عبدالله بن مسعود يخطب وهو يقول: \"يا أيها الناس عليكم بالطاعة والجماعة، فإنهما حبل الله الذي أمر به\" ثم ذكر بوجوب الرجوع إلى الكتاب والسنة بفهم سلف الأمة رضوان الله عليه في مثل هذه الفتن التي تعصف بأمة محمد صلى الله عليه وسلم. وبيَّن كذلك وجوب الرجوع إلى أهل العلم الربانيين في مثل هذه الأمور لقوله تعالى: \"فاسألوا أهل الذكر إن كنتم لا تعلمون\" فيجب على كل مؤمن موحد أن يرجع إلى أهل العلم الراسخين في العلم لأنهم أعلم الناس بهذه الفتن والتباس الحق بالباطل، وقد كان السلف رضوان الله عليهم على هذا النهج، قال عمرو بن ميمون ــ وكان في زمن الفتنة ــ: لزمت معاذ بن جبل فما فارقته حتى حثوت عليه من التراب بالشام ميتاً، ثم نظرت إلى أفقه الناس بعده فأتيت عبدالله بن مسعود فسمعته يقول: عليكم بالجماعة فإن يد الله على الجماعة. ثم ذكر أقوال أهل العلم في حرمة القيام بالمظاهرات والاعتصامات وبيّن أن هذه المظاهرات لا تأتي إلا بالشر والفتن على أمة محمد صلى الله عليه وسلم وبيّن أنها ليست من أعمال المسلمين، بل هي دخيلة على الإسلام بل انها تؤدي إلى ترويع الآمنين، وإزهاق أرواح الغافلين من المسلمين، وبث الرعب والخوف والفزع في قلوبهم في سبيل الحصول على حطام الدنيا. وفي نهاية الخطبة دعا إلى الأمن والأمان حيث قال: إن أعظم نعمة بعد التوحيد هي نعمة الأمن والأمان.');

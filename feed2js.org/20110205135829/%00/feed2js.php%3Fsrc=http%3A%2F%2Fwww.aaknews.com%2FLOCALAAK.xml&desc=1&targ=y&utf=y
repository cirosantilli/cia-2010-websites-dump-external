document.write('<li class="rss-item"><a class="rss-item" href="http://www.aaknews.com/#!428673" target="_blank">برعاية عيسى بن علي \"الكلمة الطيبة\" تبدأ التسجيل لملتقى الأشبال السنوي الأول</a><br />');
document.write('كشفت اللجنة المنظمة لملتقى الأشبال السنوى الأول الذي تنظمه جمعية الكلمة الطيبة للأطفال في الفئة العمرية 9 - 12 عاماً، الذى يقام برعاية كريمة من سمو الشيخ عيسى بن علي بن خليفة آل خليفة تحت شعار: \"باللعب نتعلم الحياة\"، خلال الفترة من 12 الى 14 فبراير، عن بدء عملية تسجيل المشاركين في المعسكر. وقال السيد عبدالعزيز راشد السندي قائد عام الملتقى إن اللجنة المنظمة تواصل اجتماعاتها من أجل اختتام التحضيرات والاستقرار على الفعاليات، التي من المتوقع أن تشمل العديد من الأنشطة المتطورة كورش العمل والألعاب والبرامج المختلفة التي تنفذ بطريقة المجموعات إضافة إلى الزيارات والبرامج الاجتماعية والخدمية، منوهاً إلى أن اللجنة المنظمة قررت قبول مشاركة 50 طفلاً، في المعسكر، حيث سيكونون تحت إشراف خمسة إداريين، وخبير متخصص من دولة تونس الشقيقة. وأشار السندي إلى أن جميع فعاليات المعسكر تتبع أسلوبا تربويا جديدا في العالم العربي، بعنوان: \"التعليم بالترفيه\" الذي يعتمد على المزج بين توظيف التسلية واللعب لإيصال رسائل تربوية تجاه الذات والأسرة والمدرسة والمجتمع والوطن. وأكد قائد عام الملتقى أن اللجنة المنظمة من أعضاء وشباب جمعية الكلمة الطيبة، يسعون إلى إخراج المعسكر وفعالياته بصورة مبهرة وجاذبة للمشاركين من أطفالنا، مضيفاً: سيكون المعسكر فرصة سانحة لقضاء أوقات ممتعة ومفيدة، وبديلاً رائعاً لجميع الأسر الراغبة في السفر إلى الخارج من أجل أن يستمتع أطفالهم باجازة منتصف العام. ودعا التربويين وأولياء الأمور الراغبين في تسجيل أبنائهم بالمعسكر إلى الإسراع بتسجيل الأسماء، عبر الإيميل sindi_55@hotmail.com، أو هاتف رقم: 39334193 -17333115 يشار إلى أن المعسكر يتزامن مع احتفالات مملكة البحرين بيوم الميثاق الوطني، ويهدف إلى غرس مفهوم المواطنة وتعليم الأطفال المشاركين حب الوطن والانتماء إلى الأرض والتفاني في خدمة مجتمعهم، وكذلك إكساب المشاركين مهارات التواصل والمشاركة في الأعمال التطوعية، وتدريبهم على الاعتماد على الذات في تسيير أمورهم الحياتية، والتحلي بالأخلاق الفاضلة.');

document.write('<li class="rss-item"><a class="rss-item" href="http://www.aaknews.com/#!428656" target="_blank">في اجتماع \"التربية\" مع ضمان الجودة بحث ترتيبات التدريب على استمارة التقييم الذاتي</a><br />');
document.write('عقد الاجتماع الدوري الشهري بين وزارة التربية والتعليم وهيئة ضمان جودة التعليم والتدريب بحضور الدكتورة جواهر المضحكي الرئيس التنفيذي لهيئة ضمان جودة التعليم والتدريب والأستاذ ناصر محمد الشيخ الوكيل المساعد للتعليم العام والفني والأستاذة لولوة آل خليفة الوكيل المساعد للمناهج والتدريب، بالإضافة إلى عدد من المديرين التنفيذيين في الهيئة ومديري التعليم ومديرة الإشراف التربوي وممثل عن كلية البحرين للمعلمين وعدد من رؤساء المدارس والمعنيين من الجانبين. وتدارس الاجتماع العديد من القضايا، ومنها نتائج الاجتماعات التشاورية التي تمت بين الهيئة ومديري المدارس وما تمخضت عنه الزيارات التي قامت بها الهيئة للمدارس التي تحتاج إلى دعم ومساندة، والترتيبات اللازمة للتدريب على استمارة التقييم الذاتي وفق التغييرات الواردة في إطار العمل الموحد المطور. وقد اتفق المجتمعون على تنظيم عدد من الورش التعريفية للتعريف بالمستجدات والمتغيرات على الأنظمة الجديدة في المناهج والتقويم وطرائق التدريس والمصطلحات التربوية المستخدمة في متابعة أداء المعلمين. بحث الاجتماع كذلك الإجراءات المطلوبة لتطبيق الامتحانات الوطنية التجريبية للمرحلة الثانوية التي ستجرى هذا العام، كما تم إجراء الورشة التدريبية للتدرب على استمارة التقويم الذاتي خلال الفترة بين 21 و 23 فبراير القادم لمديري مدارس الدفعة الأولى التي تمت مراجعة أدائها استعدادا للدورة الجديدة، بالإضافة إلى تدريب 20 اختصاصيا من الإدارات لتدريب باقي المدارس على دفعات.');

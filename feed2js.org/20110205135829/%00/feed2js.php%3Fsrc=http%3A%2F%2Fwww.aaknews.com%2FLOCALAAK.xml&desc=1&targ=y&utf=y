document.write('<li class="rss-item"><a class="rss-item" href="http://www.aaknews.com/#!428675" target="_blank">تحية لقوة دفاع البحرين في عيدها الثالث والأربعين اليوم القائد الأعلى: السلام يحتاج إلى قوة تصونه وتحميه</a><br />');
document.write('اليوم الخامس من فبراير من عام 2011م هو يوم عيد قوة دفاع البحرين الثالث والأربعين، أي مرور (43) عاما على تأسيس هذه القوة رمزا وطنيا أكبر.. ودرعا لحماية الوطن ومكتسباته.. وانجازاته.. وحضارته.. وتاريخه.. وكرامته وإصلاحاته.. وسمعته الطيبة المدوية في أرجاء الدنيا. ويعود الفضل في تأسيس هذه القوة التي أصبحت مصدر فخر وتباهي لمملكة البحرين في كل أرجاء الدنيا بتدريباتها وتجهيزاتها القتالية.. وقوة وإخلاص رجالها وتفهمها لمبادئها ورسالتها إلى الجهود المخلصة لحضرة صاحب الجلالة الملك المفدى القائد الأعلى ولمؤازرة ودعم الحكومة برئاسة صاحب السمو الملكي الأمير خليفة بن سلمان آل خليفة رئيس الوزراء، وبإشراف حثيث ومستمر من قبل صاحب السمو الملكي الأمير سلمان بن حمد آل خليفة ولي العهد نائب القائد الأعلى، ومساندة القائد العام لقوة الدفاع ووزير الدولة لشئون الدفاع ورئيس هيئة الأركان ورجال القوة البواسل وشعب البحرين الوفي ووقفته المشرفة تجاه قوة الدفاع ورجالها. ويرى جلالة الملك المفدى القائد الأعلى أن قوة الدفاع هي دائما قوة للسلام تدافع عن الوطن وكرامته، وتحمي دستوره، وميثاقه الوطني الذي أجمع عليه كل المواطنين، وجميع منجزات المملكة التنموية، ونهجها الديمقراطي والإصلاحي المتوافق عليه. وأهم ما يؤكده جلالة الملك المفدى القائد الأعلى هو أن السلام يحتاج إلى قوة تصونه وتحميه. لذلك كله وفي هذا اليوم المبارك لا يسعنا إلا أن نوجه التحية والإكبار إلى رجال قوة دفاع البحرين البواسل الذين نذروا أنفسهم للنهوض بهذا الواجب الوطني النبيل.. والذين رفعوا ويرفعون رؤوسنا إلى أعلى على الدوام، ويحققون لنا أكبر نعمة على هذه الأرض ألا وهي نعمة الأمن والأمان والاستقرار.. ننام ملء جفوننا وهم ساهرون مستعدون لبذل الغالي والنفيس والأرواح من أجل الوطن ومن أجلنا جميعا.');

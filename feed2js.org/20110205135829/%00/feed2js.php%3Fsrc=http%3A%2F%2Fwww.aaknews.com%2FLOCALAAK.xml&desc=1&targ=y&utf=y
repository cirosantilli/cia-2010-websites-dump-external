document.write('<li class="rss-item"><a class="rss-item" href="http://www.aaknews.com/#!428645" target="_blank">\"حوار\" تدرب الشباب على فن التصوير اليوم</a><br />');
document.write('ينظم نادي الضوء التابع لجمعية \"حوار\" ورشة عن أساسيات فن التصوير الليلي لهواة ومحبي التصوير الفوتوغرافي. يقدم الورشة الفنان البحريني عبدالله إبراهيم الماجد، الحائز على عدد من المراتب المتقدمة في مسابقات فنية متعددة. ويمكن للراغبين في المشاركة أو الاستفسار عن الفعاليات المــفتوحـــة للعموم الاتصال على هاتف 36642423 أو 33336331 (hew2009@liamg.com) وتنظم الورشة في اليوم السبت الموافق 5 فبراير 2011 في الساعة 4 عصرا. علما ان رسم المشاركة رمزي بقيمة 5 دنانير للمشارك. وقال منسق فعاليات نادي الضوء، عضو اللجنة التنفيذية بجمعية \"حوار\"، علي جلال إن برنامج الورشة يشمل تمهيدا نظريا ومن ثم التجول ميدانيا لالتقاط الصور يليها مراجعة لجودة الصور بحضور مقدِّم الورشة من أجل إكساب المشاركين الفائدة. سيتناول الفنان عبدالله الماجد الطرق الإحترافية لالتقاط الصور الليلية، مستعرضا مكونات وأبعاد الصورة الجميلة، وكيفية اختيار الوقت المناسب لالتقاط الصور. وسيقدِّم للمشاركين بالفعالية تمارين عملية حول كيفية اختيار الزاوية المناسبة لالتقاط الصور. يشار الى أن الفنان عبدالله الماجد قدَّم عددا من ورش العمل، وآخرها بمدينة الشباب 2030، ومركز الإبداع التابع للمؤسسة العامة للشباب والرياضة. وفاز بمسابقة شرطة طيران الخليج للصور، وحظيت صوره بمراتب متقدمة في استفتاءات متعددة. الجدير بالذكر ان \"حوار\" جمعية أهلية معنية بالشباب والتوعية الديمقراطية وتعزيز ثقافة الحوار. وأشهرت الجمعية في يناير .2009');

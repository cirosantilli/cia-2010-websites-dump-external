document.write('<li class="rss-item"><a class="rss-item" href="http://www.aaknews.com/#!428672" target="_blank">إشادة نيابية بتوجيهات القيادة لاستمرار علاوة الغلاء ودعم السلع</a><br />');
document.write('أشادت كتلة المستقلين النيابية بالتوجيهات الملكية السامية لتخصيص إعتمادات مالية في الميزانية العامة للدولة لعامي 2011 و2012 لصالح علاوة الغلاء، وزيادة الدعم الحكومي وحجم المساعدات الاجتماعية، باعتبارها ترجمة حقيقية للمبادرات الإنسانية الكريمة والمتكررة لصاحب الجلالة الملك المفدى لتحسين المستوى المعيشي للمواطنين، ودعم منظومة الحماية الاجتماعية. وأكد النائب عبدالرحمن بومجيد في بيان باسم كتلة المستقلين ترحيبه بموافقة الحكومة الرشيدة برئاسة صاحب السمو الملكي الأمير خليفة بن سلمان آل خليفة رئيس الوزراء، وبناء على التوجيهات الملكية، على العديد من القرارات المتعلقة بتحقيق مصالح المواطنين، وتأمين الرعاية والضمان الاجتماعي للأفراد والأسر المحتاجة ومحدودي الدخل، تزامنًا مع احتفالات المملكة بالذكرى العاشرة لإقرار ميثاق العمل الوطني في فبراير 2001 بنسبة 98,4% من الشعب البحريني، على أن يتم صرفها بأثر رجعي اعتبارًا من يناير .2011 وأضاف أن الموافقة على تخصيص اعتمادات مالية بقيمة 100 مليون دينار بحريني لصالح علاوة الغلاء ضمن مشروع قانون اعتماد الميزانية العامة للدولة للسنتين الماليتين 2011 و2012 تمثل أحد المكاسب الاجتماعية المهمة والتي تعكس استجابة القيادة الحكيمة لمطالب النواب بضرورة دعم الأسر محدودة الدخل، كما أنها تشكل عاملاً مساعدًا للسلطة التشريعية على الإسراع في إقرار مشروع قانون الميزانية، وخاصة بعد إجماع الكتل النيابية على كون هذه العلاوة ضرورة لاعتماد مشروع الموازنة. وأشاد النائب عبدالرحمن بومجيد بزيادة مبالغ الدعم الحكومي للسلع الغذائية الأساسية كاللحوم والطحين والدواجن إلى 132,9 مليون دينار في ميزانية الدولة لعامي 2011 و2012، بما يسهم في التخفيف من حدة ارتفاع تكاليف المعيشة وزيادة أسعار السلع والخدمات الأساسية على المواطنين، لاسيما محدودي ومتوسطي الدخل. ورحب باعتماد الحكومة لزيادة المساعدات الاجتماعية من 28,8 مليون دينار إلى 40 مليونًا للسنتين 2011 و2012 وفقا لقانون الضمان الاجتماعي، وتنفيذًا للمادة الخامسة من دستور مملكة البحرين التي تنص على كفالة الدولة لتحقيق الضمان الاجتماعي اللازم للمواطنين في حالة الشيخوخة أو المرض أو العجز عن العمل أو اليتم أو الترمل أو البطالة، بالإضافة إلى تأمين خدمات التأمين الاجتماعي والرعاية الصحية، والعمل على وقايتهم من براثن الجهل والخوف والفاقة، من خلال توسيع شبكات الحماية الاجتماعية لتنمية الأسرة المحتاجة. وفي ختام البيان، أعرب عضو كتلة المستقلين النائب عبدالرحمن بومجيد عن تقدير الكتلة للتدخلات الحكيمة لجلالة الملك المفدى والتي تصب دائما في صالح تحسين المستوى المعيشي للمواطنين وتلبية احتياجات الأسر البحرينية من مختلف السلع الاساسية والمرافق العامة والخدمات الاجتماعية كالصحة والتعليم والإسكان، والاستمرار في مكافحة الفقر والبطالة، بما يوفر سبل العيش الكريم للإنسان البحريني، باعتباره محور المشروع الإصلاحي لصاحب الجلالة الملك المفدى. وأشار النائب علي زايد بان مملكة البحرين وبمختلف اطيافها وطوائفها يدعون المولى عز وجل ان ينعم على جلالة الملك المفدى بموفور الصحة والسعادة، وان يبقى عزا وذخرا لهذا الوطن الذي ينعم بالامن والامان في ظل قيادة جلالته الحكيمة، متضرعين ان يحفظ الله جلالته ويحقق مايصبو اليه من رفعة وتقدم وازدهار في ظل عهده الزاهر الذي شهدت المملكة فيه انجازات ومكاسب محلية وعالمية في مختلف الميادين والاصعدة. واستشهد النائب زايد بكلمة حضرة صاحب الجلالة الملك المفدى حفظه الله عندما قال (إننا ماضون في مسيرة البناء الوطني لخير الجميع)، مستذكرا اللفتة الابوية للوالد القائد عندما اصدر توجيهاته السامية في ادراج علاوة الغلاء في ميزانية 2009 - 2010م، فالمتابعة الحثيثة لجلالته لاحتياجات ابناء شعبه، أمر ليس بغريب ولا جديد، فجلالته دائما ما يستشعر هموم المواطنين في سبيل نحقيق الرخاء والعيش الكريم لهم، فها نحن نرى جلالته يستقبل المواطنين والهيئات والجمعيات والمؤسسات ويطمئن على احوالهم ويوجه المسئولين في المملكة بالتيسير والتسهيل عليهم من خلال توفير مختلف الخدمات الى المواطنين الكرام، فمنذ ان تولى جلالته الحكم وانطلاق مشروعه الاصلاحي وها نحن نستقبل مكارمه التي لا تحصى بالفرح والسعادة. وأوضح زايد أن مسألة ارتفاع اسعار السلع الاساسية ورفع الدعم عنها، كانت الشغل الشاغل للمواطنين، فجاءت توجيهات جلالة الملك كالماء البارد الذي اثلج صدور المواطنين الذين عبروا عن شكرهم وتقديرهم لرعاية واهتمام جلالته الأبوية لأبناء شعبه الوفي، وسعيه الدؤوب لتوفير الحياة الكريمة لهم، مؤكدين مبايعتهم ومساندتهم للملك في ترسيخ الثوابت الوطنية واحترام القانون والعمل بكل جد وإخلاص للمشاركة في عملية البناء والتحديث التي تشهدها المملكة في عهد جلالته، عهد ميثاق وإصلاح وعمل وطني، فها هم ابناء الشعب يبادلون جلالته الحب والوفاء ويعاهدونه بالولاء والطاعة.');

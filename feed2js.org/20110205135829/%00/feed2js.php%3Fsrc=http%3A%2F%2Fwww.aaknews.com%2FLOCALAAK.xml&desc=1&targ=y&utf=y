document.write('<li class="rss-item"><a class="rss-item" href="http://www.aaknews.com/#!428665" target="_blank">السماح لـ 1637 مستحضرا وفق الاحصاءات الصحية ترخيص 18 محلا للعطارة ومنع 53 مستحضرا تجميليا</a><br />');
document.write('منحت وزارة الصحة ترخيص مزاولة مهنة العطارة لـ 18 محلا بالإضافة إلى سماحها لـ 222 محلا تجاريا باستيراد وتصدير وبيع مستحضرات التجميل خلال العام المنصرم. فيما كشفت السجلات الصحية لوزارة الصحة وتحديدا لمجموعة سلامة المواد الاستهلاكية بإدارة الصحة العامة منع 53 مستحضرا تجميليا من دخول اسواق المملكة لعدم مطابقتها للمواصفات والاشتراطات المعتمدة، في المقابل سمح لـ 1637 مستحضرا على اساس الاستعمال الشخصي أو البيع. كما نفذت مجموعة سلامة المواد الاستهلاكية 200 زيارة تفتيش شملت محلات ومؤسسات خاضعة للرقابة. حيث قام أفراد المجموعة بإصدار 9 مخالفات للمحلات غير الملتزمة بالاشتراطات والأنشطة الخاضعة للرقابة، كما تمت معاينة ومعالجة 5 شكاوى من الجمهور إضافة إلى إلقاء 4 محاضرات تثقيفية للجمهور أما فيما يخص موظفي المجموعة فقد تم إقامة 8 ورش عمل ودورات تدريبية. ومن جانبه قال رئيس قسم صحة البئية عبدالله الستراوي إن القسم حقق الكثير من الإنجازات خلال العام المنصرم ومنها قيام مفتشي وحدة مكافحة القوارض بتنفيذ برامج دورية لمكافحة القوارض في جميع محافظات المملكة، حيث تم وضع الطعوم السامة للفئران في (66761) فتحة مجاري في جميع شبكات المجاري العامة بالتعاون مع إدارة تشغيل وصيانة الصرف الصحي بوزارة الأشغال والإسكان، كما تم معاينة ومعالجة (88870) موقعاً بالمناطق السكنية و(4056) موقعاً بالأسواق العامة ومعالجتها بسموم القوارض، مفيدا بأن المفتشين الصحيين تعاملوا مع (1113) بلاغاً مقدماً من الجمهور عن القوارض وتمت معالجتها بالطعوم المناسبة كما تم تحرير (97) من الإخطارات الصحية. وأشار إلى ان وحدة مكافحة القوارض استهلكت خلال العام الماضي (36546) كيلوجراماً من الطعوم السامة الجافة و(43) مصيدة لاصقة بالإضافة إلى توزيع طعم القوارض على الجمهور عند الطلب. وأوضح الستراوي أن مجموعة دراسات الحشرات قامت بشهر يونيو 2010م بإجراء مسح بجميع المحافظات لأنواع الذباب لتحديد الكثافة والنوع والأهمية الطبية لها، مشيرا إلى انه بناء على ذلك سيتم تحليل البيانات التي تم جمعها الأشهر القادمة. وقال إنه تم تجربة (79) مبيدا للحشرات والقوارض استقبلتها المجموعة من المزودين، إضافة إلى فحص (1305) بؤرات لتوالد البعوض بمختلف المحافظات وجد منها (110) بؤرات إيجابية لبعوض الأنوفلس الناقل للملاريا و(523) بؤرة توالد لبعوض الكيولكس. منوها إلى انه تم تثبيت (394) من المصائد الضوئية لجمع البعوض البالغ والحشرات الأخرى الطائرة وتصنيفها، كما تم نصب (76) مصيدة للفئران بغية التعرف على أنواعها وكثافتها بالمناطق إضافة إلى إيجاد كثافة البراغيث عليها وإجراء التجارب عليها. وذكر الستراوي أن اختصاصيي المجموعة قاموا بتدريب (32) طالبا وطالبة من كلية العلوم الصحية على أعمال الدراسات الميدانية والمعملية للحشرات والقوارض، كما تم التعرف على نوع جديد من أنواع البعوض (المانسونيا) بمنطقة توبلي أثناء التصنيف للبعوض الذي يتم جمعه بالمصائد الضوئية، ومازالت المتابعة جارية للبحث عن بؤر توالد هذا النوع من البعوض وأماكن وجوده - حيث إن هذا النوع ينقل مرض داء الفيل. أما بالنسبة إلى مجموعة مراقبة صحة المياه والمؤسسات فقال الستراوي إن مفتشي المجموعة نفذوا (14233) زيارة تفتيش للمحلات والمؤسسات الخاضعة لرقابتها على مستوى جميع محافظات المملكة وشملت (7640) زيارة تفتيشية لصالونات الحلاقة والتجميل والرشاقة الرجالية والنسائية والصالات الرياضية والنوادي الصحية، و(717) زيارة تفتيشية للفنادق والشقق المفروشة الفندقية. بالإضافة إلى (448) زيارة تفتيشية للمؤسسات التعليمية الحكومية والخاصة و(188) زيارة لدور الحضانة ورياض الأطفال. كذلك (110) زيارات تفتيشية لبرك السباحة.وكشف الستراوي عن إصدار المجموعة لـ (5773) إخطاراً عن مخالفات صحية منها (526) غرامة مالية وإغلاق (8) مؤسسات بحسب التدرج القانوني للإنذارات والغرامات. كما تم الترخيص لـ (444) مؤسسة من بين (672) مؤسسة تم معاينتها.');

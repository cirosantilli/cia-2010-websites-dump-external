document.write('اليوم السابعتبرئة الناشطة التونسية في &quot;فيمن&quot; من الإساءة لحارس سجنالعربية نتأسقط القضاء التونسي الاثنين التهمة الموجهة إلى أمينة السبوعي، عضوة منظمة فيمن، بالإساءة إلى حارس سجن لكنها ما زالت في الاعتقال لأنها كتبت كلمة فيمن على جدار مقبرة، كما ذكر محاميها. وقال غازي مرابط إن &quot;المحكمة قررت إسقاط التهمة عن أمينة، وهذا انتصار، بدأ القضاء يدرك أنها ظلمت&quot;. وأضاف أنها ما زالت مع ذلك موقوفة في انتظار احتمال اتهامها بـ &quot;بتدنيس مقبرة والإساءة الى العادات والتقاليد&quot;. وقد تم توقيف أمينة (19 عاماً) في 19 مايو/أيار الماضي لرسمها كلمة &quot;فيمن&quot; على سور مقبرة في مدينة القيروان وسط تونس، احتجاجاً على تجمع سلفي، كان من المزمع ...تبرئة أمينة السبوعى من تهمة الإساءة لحارس لكنها ما زالت موقوفةاليوم السابعتونس: تبرئة أمينة السبوعي من تهمة الإساءة لحارس لكنها ما زالت موقوفةالاقتصاديةجميع المقالات البالغ عددها 3 »');

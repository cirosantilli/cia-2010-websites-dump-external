document.write('الجريدةوزير الخارجية المصري: لحل سياسي في سوريةدار الحياةأعلنت وزارة الخارجية المصرية أن &quot;الوزير نبيل فهمي شدد خلال جلسة مباحثات عقدها مع الممثلة العليا للسياسة الخارجية والأمنية في الاتحاد الأوروبي كاثرين آشتون على أهمية التوصل إلى حل سياسي للأزمة السورية&quot;. وقال الناطق الرسمي بإسم الوزارة بدر عبد العاطي، إن فهمي أكد &quot;أهمية التوصل إلى حل سياسي للأزمة السورية بما يسمح بوقف أعمال قتل المدنيين ويضمن بناء نظام ديمقراطي حقيقي يعكس تطلعات الشعب السوري وتنوعه الديني والمذهبي والإثني ويحفظ لسوريا وحدتها الإقليمية&quot;. وأضاف عبد العاطي أن اللقاء تناول قضية سد النهضة الإثيوبي حيث ...«آشتون»: أدعو لمشاركة كافة القوى السياسية بالعملية الديمقراطية دون إقصاءالشروقالخارجية : فهمى عرض على آشتون تطورات الأوضاع فى الداخل والخارجالفجرالخارجية: فهمي بحث مع آشتون التطورات الداخلية وقضايا اقليميةاتحاد الإذاعة والتلفزيون المصرىاخبار اليوم -وكالة أنباء البحرين -النهارجميع المقالات البالغ عددها 11 »');

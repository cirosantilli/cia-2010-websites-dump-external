document.write('الاحساء اليوم النسخة الكفيةمقتل شاب وإصابة 4 في مشاجرة استخدم فيها الرصاص بحفر الباطنالاحساء اليوم النسخة الكفيةتسببت مشاجرة جماعية بحفر الباطن استخدم فيها الرصاص في وفاة شاب وإصابة أربعة آخرين نقلوا على إثرها إلى المستشفى لتلقي العلاج. وتعود التفاصيل إلى شجار حدث بين مجموعة من الدرباوية في الفاو الشمالي، تطور لينتقل إلى داخل محافظة حفر الباطن، ويتم فيه استخدام الأسلحة النارية مما أسفر عن مقتل شاب وإصابة خمسة آخرين بإصابات متفرقة وتم نقلهم إلى مستشفى الملك خالد العام بحفر الباطن. وأوضح المتحدث الرسمي باسم شرطة المنطقة الشرقية؛ المقدم زياد الرقيطي، أن القاتل تم القبض عليه، وتجري عمليات الضبط الجنائي للواقعة ...والمزيد »');

document.write('الرئيس الفرنسى يرحب بحسن سير الانتخابات فى مالىاليوم السابعرحب الرئيس الفرنسى فرنسوا هولاند فى بيان نشر اليوم الاثنين، &quot;بحسن سير&quot; الاقتراع الرئاسى فى مالى الذى شهد &quot;تعبئة كبيرة ويدون حادث كبير&quot;. وقال هولاند إن &quot;الملاحظات الأولى لبعثة الاتحاد الأوروبى، &quot;أشارت إلى غياب حوادث على الرغم من تهديدات جماعة جهادية&quot;. وعبر عن ارتياحه لأن &quot;هذه الانتخابات تكرس عودة مالى إلى النظام الدستورى بعد الانتصار الذى تحقق على الإرهابيين وتحرير الأراضى&quot;. وتابع هولاند أن &quot;المشاركة غير المسبوقة التى سجلت أمس فى مالى تدل على حرص الماليين على القيم الديمقراطية، أنها فرصة ورمز&quot;.والمزيد »');

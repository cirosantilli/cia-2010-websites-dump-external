document.write('<li class="rss-item"><a class="rss-item" href="http://www.alrafidayn.com/2009-05-26-22-17-29/29637-2011-02-04-21-59-04.html" target="_blank">هوار يسبب أزمة لنادي إيراني..العمدة يخوض أولى مبارياته مع بوشهر أمام سبهان</a><br />');
document.write('بغداد:  يخوض مهاجم منتخبنا الوطني لكرة القدم عماد محمد أولى مبارياته الرسمية مع فريق شاهين بوشهر الايراني أمام فريق سبهان أصفهان اليوم السبت في افتتاح منافسات الأسبوع 21 من دوري المحترفين الايراني للموسم الحالي 2010 -2011 .ونقل مصدر مقرب من المهاجم عماد محمد أن الاتحاد الإيراني لكرة القدم استكمل إجراءات تسجيله رسميا في صفوف فريق شاهين بوشهر بعد وصول البطاقة الدولية الكترونية للأخير التي تخوله المشاركة مع فريقه الجديد في المنافسات الرسمية ابتداء من مباراته القادمة التي سيلعب فيها أمام فريقه السابق سبهان أصفهان ضمن الجولة 21 لدوري المحترفين الايراني قادما من نادي الزمالك المصري على سبيل الإعارة حتى نهاية الموسم الحالي مقابل 350 ألف دولار .من جهة أخرى رفض الاتحاد الآسيوي لكرة القدم طلب نادي الاستقلال الايراني بإدراج لاعب جديد بدلا من اللاعب هوار ملا محمد الذي تم إدراجه في كشوفات الفريق المرسلة إلى لجنة المسابقات في الاتحاد الآسيوي للمشاركة في دوري المحترفين الآسيوي للموسم الجديد 2011 -2012 رغم أن الأخير لم يكمل اجراءات التعاقد النهائي معه وفضل الانتقال للعب في صفوف نادي ليماسول القبرصي .');

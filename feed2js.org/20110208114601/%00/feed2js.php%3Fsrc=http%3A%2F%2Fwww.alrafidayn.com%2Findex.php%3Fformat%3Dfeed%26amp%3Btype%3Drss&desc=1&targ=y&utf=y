document.write('<li class="rss-item"><a class="rss-item" href="http://www.alrafidayn.com/2009-05-26-22-17-29/29667-2011-02-06-07-21-01.html" target="_blank">أبرزها الانتخابات ومصير سيدكا ..اتحاد الكرة يناقش ملفات ساخنة للعبة على طاولته</a><br />');
document.write('بغداد - حيدر مدلول  : يعقد الاتحاد العراقي المركزي لكرة القدم اليوم الأحد اجتماعا استثنائيا في مقره بالقرب من مجمع الشعب الدولي في بغداد برئاسة ناجح حمود النائب الأول وحضور جميع أعضائه لمناقشة العديد من المواضيع المطروحة على جدول أعماله  التي تخصّ مسيرة المنتخبات الوطنية العراقية والانتخابات الجديدة. وقال هادي جواد عضو الاتحاد العراقي المركزي لكرة القدم : سيتم خلال الاجتماع المذكور الاتفاق على تحديد النصف الثاني من شهر شباط الحالي موعدا لإجراء انتخاباته الجديدة لاختيار مجلس إدارة جديد لمدة أربع سنوات قادمة يقود الكرة العراقية والتي في ضوئها سيتم إرسال كتاب رسمي إلى الاتحاد الدولي لكرة القدم (فيفا) لتبليغه بموعد الانتخابات وضرورة إرسال ممثل عنه لحضورها ومراقبتها والتي ستقام تحت إشراف قضائي واستجابة لرغبة الهيئة العامة لاتحاد الكرة التي حددت شهر شباط الحالي موعدا لإجراء الانتخابات خلال الاجتماع الأخير الذي عقدته في مقر الاتحاد في شهر تشرين الأول الماضي، ولا نية لإرجاء الانتخابات في وقت آخر.وأشار جواد إلى انه سيتم خلال الاجتماع المذكور مناقشة نتائج مشاركة منتخبنا في بطولة كأس أمم آسيا 2011 التي اختتمت مؤخرا في العاصمة القطرية الدوحة ومصير الملاك الإداري والمدرب الألماني سيدكا بعد الاستماع إلى التقرير الذي سيقدمه عبد الخالق مسعود رئيس وفدنا لهذه البطولة وكذلك الملاحظات التي سيبديها أعضاء لجنة المنتخبات الوطنية بشأن الأسباب التي أدت إلى خروج منتخبنا من الدور ربع نهائي بعد خسارته أمام استراليا بهدف وحيد وكذلك بحث توفير أفضل سبل الإعداد   لمنتخبنا الاولمبي الذي يستعد للمشاركة في تصفيات الدور الثاني للقارة الآسيوية المؤهلة إلى اولمبياد لندن 2012 التي ستقام خلال شهر حزيران المقبل وتسمية الملاك التدريبي الذي سيقوده وغيرها من المواضيع التي تخص مسيرة المنتخبات الأخرى والأندية العراقية التي تتحضر للمشاركة في النسخة الجديدة من بطولة كأس الاتحاد الآسيوي ومنافسات دوري النخبة للموسم الحالي.وكشف جواد انه سيتم مناقشة التحضيرات التي سيتهيء لها اتحاد الكرة بالتعاون مع وزارة الشباب والرياضة ومجلس محافظة البصرة والجهات الساندة لاستقبال وفد خليجي الذي يضم أربعة مهندسين إنشائيين من قطر والإمارات والكويت والسعودية الذي سيقوم بجولة تفتيشية بداية شهر نيسان المقبل لمتابعة سير تنفيذ المدينة الرياضية في البصرة التي ستقام عليها مباريات خليجي 21  خلال الفترة من 5 - 18 من كانون الثاني من عام 2013.من جهة أخرى سمى الاتحاد العراقي المركزي لكرة القدم وفد منتخب الأشبال لمواليد 1998 الذين سيشارك في منافسات مهرجان الرؤية الأسيوية الذي سيقام في العاصمة القطرية الدوحة خلال الفترة من الثاني  عشر ولغاية السابع والعشرين من شباط الجاري إلى جانب عشر دول  من غرب آسيا ( قطر والبحرين والأردن ولبنان وسلطنة عُمان وفلسطين وسوريا والسعودية والإمارات واليمن).وقال طارق احمد أمين سر العام في الاتحاد العراقي المركزي باللعبة إن عضو لجنة المنتخبات الوطنية في اتحاد الكرة صباح محمد مصطفى سيترأس الوفد الذي يضم إلى جانبه الملاك التدريبي المؤلف من طالب جلوب مدربا وحامد حاتم مدربا مساعدا فضلا عن 22 لاعبا تم اختيارهم للمشاركة في منافسات المهرجان وهم كلا من: سيف علي حسين وسيف جاسم كنعان وحيدر علي كاظم وصفاء هادي عبد الله ومصطفى كريم شنيل وكرار نوري عطا الله ومصطفى محمد جبر وحسين علي كاظم وعلي عباس عبد الحسين ومحمد حسين علي وعلي يوسف اطعيمة وعبد الله رياض عبد العباس وعلي جواد كاظم وحسام حسن محمود ومياسر محمد كاطع ومعتز حسين عباس وعلي حسين علي وثامر سلام ليلو ومحمد عبد الهادي اعرير واحمد حسين ناصر وسجاد حسين عبد وعلي سلام كاطع.');

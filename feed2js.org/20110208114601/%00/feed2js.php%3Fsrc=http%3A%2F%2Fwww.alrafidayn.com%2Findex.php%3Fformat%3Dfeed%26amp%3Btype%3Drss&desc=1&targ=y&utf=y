document.write('<li class="rss-item"><a class="rss-item" href="http://www.alrafidayn.com/2009-05-26-22-07-53/29664---3------.html" target="_blank">انتخاب رؤساء 3 لجان دائمة في مجلس النواب العراقي</a><br />');
document.write('بغداد: انتخب مجلس النواب االعراقي رؤساء لثلاثة لجان دائمة اليوم السبت.وانتخب اعضاء لجنة النزاهة النائب عن التحالف الوطني بهاء الاعرجي رئيسا لها والنائب عن القائمة العراقية احمد الجبوري نائبا للرئيس.كما انتخبت لجنة حقوق الإنسان النائب سليم الجبوري عن تحالف الوسط رئيسا لها والنائب خالد نعيم نائبا له،فيما انتخبت لجنة النفط والطاقة والثروات الطبيعية النائب عن القائمة العراقية عدنان الجنابي رئيسا لها.وكانت لجنة صياغة النظام الداخلي للبرلمان العراقي، أعلنت مطلع الشهر الماضي، عن الاتفاق على تشكيل 26 لجنة نيابية دائمة توزع على الكتل البرلمانية بحسب الاستحقاق الانتخابي.');
document.write('</li>');
document.write('<li class="rss-item"><a class="rss-item" href="http://www.alrafidayn.com/2009-05-26-22-07-53/29661-2011-02-06-07-05-31.html" target="_blank">رئيس الوزراء العراقي يقرر خفض راتبه الشهري الى النصف</a><br />');
document.write('بغداد : قرر رئيس الوزراء العراقي نوري المالكي خفض راتبه الشهري بنسبة خمسين في المئة واعادة النصف الاخر الى خزينة الدولة، في خطوة تهدف لتقليص الفوارق المعيشية في البلاد.');

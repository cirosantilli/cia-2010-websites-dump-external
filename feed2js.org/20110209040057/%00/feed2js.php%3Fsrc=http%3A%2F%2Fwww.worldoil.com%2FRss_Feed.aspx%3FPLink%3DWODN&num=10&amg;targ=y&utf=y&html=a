document.write('<li class="rss-item"><a class="rss-item" href="http://www.worldoil.com/ONGC_enters_Northeast_India_with_Mizoram_well.html" target="_self">ONGC enters Northeast India with Mizoram well</a><br />');
document.write('India’s Oil &amp; Natural Gas Corporation (ONGC) has recently spudded a well in Mizoram in Northeast India after a hiatus of 20 years.');

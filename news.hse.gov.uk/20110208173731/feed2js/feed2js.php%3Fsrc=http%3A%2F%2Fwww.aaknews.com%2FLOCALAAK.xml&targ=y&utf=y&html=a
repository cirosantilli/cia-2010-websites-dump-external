document.write('<li class="rss-item"><a class="rss-item" href="http://www.aaknews.com/#!428909" title="    استقبل السيد سلمان بن عيسى بن هندي محافظ محافظة المحرق بمكتبه بمبنى المحافظة السيد يونغ وينغو سفير جمهورية الصين الشعبية لدى مملكة البحر�..." target="_blank">محافظ المحرق يستقبل السفير الصيني  </a><br />');
document.write('    استقبل السيد سلمان بن عيسى بن هندي محافظ محافظة المحرق بمكتبه بمبنى المحافظة السيد يونغ وينغو سفير جمهورية الصين الشعبية لدى مملكة البحرين. وقد رحب المحافظ بالسفير الصيني، متمنيا له طيب الإقامة في مملكة البحرين والتوفيق في مهام عمله الدبلوماسي، كما استعرض الجانبان خلال اللقاء العلاقات الودية بين البلدين وسبل دعمها وتطويرها لما فيه خير وصالح البلدين والشعبين الصديقين.  <p>  ');

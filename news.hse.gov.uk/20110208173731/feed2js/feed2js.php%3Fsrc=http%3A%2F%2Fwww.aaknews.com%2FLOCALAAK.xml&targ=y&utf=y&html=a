document.write('<li class="rss-item"><a class="rss-item" href="http://www.aaknews.com/#!428923" title="   بمناسبة يوم الرابع من فبراير الجاري يوم البيئة الوطني في البحرين كشفت &quot;ديار المحرق&quot; إحدى أكبر الشركات الوطنية الرائدة في عالم التطوي�..." target="_blank">ديار المحرق.. تحتفل بيوم البيئة العالمي  </a><br />');
document.write('   بمناسبة يوم الرابع من فبراير الجاري يوم البيئة الوطني في البحرين كشفت \"ديار المحرق\" إحدى أكبر الشركات الوطنية الرائدة في عالم التطوير العمراني والإسكان الحضري الممولة برأسمال القطاع الخاص، عن جهودها المكثفة في تقديم الدعم ورعاية العديد من الفعاليات المحلية والعالمية من مؤتمرات ومعارض وأنشطة مجتمعية تمت إقامتها أو تنفيذها في المملكة خلال الفترة الماضية، باعتبارها من شركات التنمية الحضرية الكبرى التي تتبنى شعار تعميم العمارة الخضراء المستدامة، وتشجيع كل تعاون بناء مشترك بين القطاعات والشركات المحلية والعالمية الرامية إلى تعزيز الإجراءات البيئية المستقبلية المتعلقة باستدامة صحة البيئة وحمايتها والمحافظة عليها سليمة، في ظروف التنمية الاقتصادية التي شملت كل القطاعات وميادين الحياة، وذلك بدافع إحساسها بالمسئولية الوطنية عن رفع الوعي المجتمعي الرصين بأهمية الحفاظ على البيئة الخضراء، والعمل على استمرار التوازن بين تصاعد وتيرة استثمار الموارد الطبيعية، واستخدام التكنولوجيا الحديثة وتقنياتها في مجال الصناعة الاستخراجية والتحويلية، مع إسهاماتها وجهودها في مكافحة ما يمكن أن ينجم عنها من مخلفات ضارة والحد من البقايا والعوادم والنفايات ومصاحباتها المسيئة إلى البيئة، والتخلص منها ومن عواقبها وعوارضها بطرق علمية حديثة تضمن وقاية البيئة وسلامتها نقية من كل شائبة واستدامتها صالحة لحياة الناس وسعادة حياتهم ودوام صحتهم، وهو ما تنشده ديار المحرق للمجتمع البحريني الكريم بكل شرائحه ومناطق تواجده الجغرافية السكنية والسياحية، دعما لاقتصاد بلدنا وتعزيزا لصحة أهلنا في المملكة.  وبمناسبة اليوم الرابع من فبراير اليوم العالمي للبيئة الذي اتخذت منه البحرين يوما وطنيا للبيئة أدلى السيد عارف هجرس الرئيس التنفيذي لديار المحرق بحديث أكد فيه التزامه الثابت على الوفاء بمتطلبات البيئة والعمارة الخضراء المستدامة بكل ما يعنيه المصطلح من ثوابت ودلالات فنية واجتماعية واقتصادية، فمن حق أهلنا في البحرين وأجيالنا القادمة أن نترك لهم ما يسد حاجتهم من الموارد وأن يرثوا منا بيئة نقية وأجواء سليمة أرضا ومياها وهواء، و لذلك نحرص على إشاعة الوعي السليم بأهمية تحدي كل الملوثات بالعمل على مراعاة شروط السلامة المجتمعية في منشآتنا ومشاريعنا العمرانية، ومنح البيئة مظاهر الاعتبار الذي تستحقه، وحشد الجماهير وتعبئتها للاحتفال بيوم البيئة التي تستحق منا التعامل معها بلمسات إنسانية صادقة. وأضاف: إن عنايتنا بالبيئة تأتي من التزام \"ديار المحرق\" الاجتماعي والاقتصادي ومسئوليتها كإحدى أكبر شركات التطوير العمراني الحضري وقد دأبت على التصدي لكل ما يضر بالبيئة والتمسك بثوابتها المعلنة في أدبياتها، خدمة للبحرينيين جميعا في مجال إقامة المؤتمرات والمعارض ذات الصلة بالاقتصاد والتنمية العمرانية باعتبارنا شركة صديقة للبيئة، وتحمل على عاتقها مسئولية استدامتها و تحقيق أقصى ما يمكن من الوعي لدى الجمهور، \"فديار المحرق\" مطور فاعل اجتماعيا واقتصاديا وبيئيا وحضريا. وتجدر الإشارة إلى جملة من الفعاليات والأنشطة التي اضطلعت ديار المحرق بدعمها ومساندتها ورعايتها ومنها:  شمول \"ديار المحرق\" برعايتها الذهبية إقامة مؤتمر القمة العالمي للبيئة حوار الشرق الأوسط، الذي استضافته مملكة البحرين في الفترة من 27 الى 28 يناير 2011 في فندق ريتز كارلتون برعاية من الدكتور عبدالحسين بن علي ميرزا وزير شئون النفط والغاز ورئيس مجلس الإدارة والبيئة الوطنية للنفط والغاز، باعتبار هذا القطاع من الميادين المهمة التي تتطلب بذل المزيد من العناية بالموارد الطبيعية واستثمارها مع ضمان تصريف مخلفاتها وتحويلها من عوادم ونفايات إلى بقايا مفيدة اقتصاديا وسليمة لا ضرر منها، والتعامل مع كل أنواع النفايات بالطرق العلمية التي تضمن عدم تلوث البيئة إضافة الى عدم اهدار ما يمكن الإفادة منه.  كما قدمت \"ديار المحرق\" دعما لجمعية المحرق الأهلية لتمويل تنظيم مشروع تنظيف سوق المحرق القديم الذي تولى القيام به أعضاء الجمعية بمشاركة بلدية المحرق وشركة مدينة الخليج للتنظيف، شاهدا على نشاطها في دعم العديد من الأنشطة الاجتماعية والخيرية والتعليمية وخدمات تطوير البيئة، سعيا لخدمة مواطني المحرق والحفاظ على مدينتهم نظيفة جميلة وزرع روح الانتماء والمبادرة بينهم، في التفاعل مع كل ما هو  مفيد ويصب في صالح منطقتهم بشكل خاص، ومناطق مملكة البحرين عامة.  <p>  ');

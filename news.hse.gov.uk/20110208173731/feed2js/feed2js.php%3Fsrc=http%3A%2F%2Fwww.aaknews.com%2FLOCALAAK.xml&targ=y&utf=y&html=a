document.write('   غادرت البلاد ظهر امس صاحبة الجلالة الملكة مارجريت الثانية ملكة الدنمارك بعد زيارة رسمية للمملكة اجرت خلالها مباحثات مع حضرة صاحب الجلالة الملك حمد بن عيسى آل خليفة عاهل البلاد المفدى تناولت العلاقات الثنائية بين البلدين الصديقين.  وكان في مقدمة مودعي جلالتها سمو الشيخ محمد بن مبارك آل خليفة نائب رئيس مجلس الوزراء والشيخة مي بنت محمد آل خليفة وزيرة الثقافة رئيسة بعثة الشرف ومحافظ محافظة المحرق والسفير الدنماركي لدى المملكة.     <p>  ');
